extContent;\\n        if (!pokemonName) return;\\n        \\n        console.log(`为 ${pokemonName} 的技能添加点击事件`);\\n        \\n        this.movesContainer.querySelectorAll('.move-grid').forEach(moveGrid => {\\n            // 移除旧的事件监听器，防止重复绑定\\n            moveGrid.removeEventListener('click', this.handleMoveClick);\\n            \\n            // 添加新的点击事件\\n            moveGrid.addEventListener('click', (event) => {\\n                const moveName = moveGrid.querySelector('.move-name')?.textContent;\\n                if (!moveName) return;\\n                \\n                console.log(`点击技能: ${moveName}`);\\n                \\n                // 播放点击音效\\n                playClickSound();\\n                \\n                // 显示确认对话框\\n                showConfirmDialog(`确定要让 ${pokemonName} 使用 ${moveName} 吗？`, function() {\\n                    // 发送请求\\n                    const command = `/send <Request:根据前文创造后续剧情，剧情中{{User}}决定让${pokemonName}使用${moveName}>`;\\n                    triggerSlash(command);\\n                });\\n            });\\n        });\\n    }\\n}\\n\\n// 队伍管理器 - 负责更新宝可梦队伍\\nclass TeamManager {\\n    constructor() {\\n        this.teamContainer = document.querySelector('.team-container');\\n    }\\n    \\n    updateTeam(team) {\\n        if (!this.teamContainer || !team) return;\\n        \\n        // 清除现有内容\\n        this.teamContainer.innerHTML = '';\\n        \\n        // 添加队伍中的宝可梦\\n        team.forEach(pokemon => {\\n            const pokemonElement = document.createElement('div');\\n            pokemonElement.className = 'team-pokemon';\\n            pokemonElement.dataset.id = pokemon.id;\\n            \\n            pokemonElement.innerHTML = `\\n                <div class=\\\"pokemon-cell name\\\">${pokemon.name}</div>\\n                <div class=\\\"pokemon-cell level\\\">Lv.${pokemon.level}</div>\\n                <div class=\\\"pokemon-cell gender\\\">${pokemon.gender}</div>\\n                <div class=\\\"pokemon-cell fusion\