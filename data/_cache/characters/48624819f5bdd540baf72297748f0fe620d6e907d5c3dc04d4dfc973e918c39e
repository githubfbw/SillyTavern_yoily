ment.querySelector('.items-container');\\n        this.moneyElement = document.querySelector('.money-amount');\\n    }\\n    \\n    updateInventory(items, money) {\\n        // 更新金钱\\n        if (this.moneyElement && money !== undefined) {\\n            this.moneyElement.textContent = money;\\n        }\\n        \\n        // 更新物品\\n        if (this.itemsContainer && items) {\\n            this.itemsContainer.innerHTML = '';\\n            \\n            if (items.length === 0) {\\n                const emptyMessage = document.createElement('div');\\n                emptyMessage.className = 'empty-message';\\n                emptyMessage.textContent = '你的背包是空的';\\n                this.itemsContainer.appendChild(emptyMessage);\\n                return;\\n            }\\n            \\n            items.forEach(item => {\\n                const itemElement = document.createElement('div');\\n                itemElement.className = 'item-card';\\n                \\n                itemElement.innerHTML = `\\n                    <div class=\\\"item-info\\\">\\n                        <div class=\\\"item-name\\\">${item.name}</div>\\n                    </div>\\n                    <div class=\\\"item-quantity\\\">x${item.count}</div>\\n                `;\\n                \\n                this.itemsContainer.appendChild(itemElement);\\n            });\\n        }\\n    }\\n}\\n\\n// 目标管理器 - 负责更新任务目标\\nclass GoalManager {\\n    constructor() {\\n        this.goalsContainer = document.getElementById('goals-container');\\n    }\\n    \\n    updateGoals(goals) {\\n        if (!this.goalsContainer) return;\\n        \\n        this.goalsContainer.innerHTML = '';\\n        \\n        if (!goals || goals.length === 0) {\\n            const emptyMessage = document.createElement('div');\\n            emptyMessage.className = 'empty-message';\\n            emptyMessage.textContent = '你目前没有任何任务';\\n            this.goalsContainer.appendChild(emptyMessage);\\n            return;\\