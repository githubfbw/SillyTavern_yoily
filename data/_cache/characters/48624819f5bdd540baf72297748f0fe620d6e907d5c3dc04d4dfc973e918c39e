\">空位</div>\\n                        <div class=\\\"pokemon-cell level\\\">-</div>\\n                        <div class=\\\"pokemon-cell gender\\\">-</div>\\n                        <div class=\\\"pokemon-cell fusion\\\">-</div>\\n                        <div class=\\\"pokemon-cell nature\\\">-</div>\\n                        <div class=\\\"pokemon-cell type\\\">-</div>\\n                        <div class=\\\"pokemon-cell status\\\">-</div>\\n                    </div>\\n\\n                    <!-- 空位 -->\\n                    <div class=\\\"team-pokemon empty\\\">\\n                        <div class=\\\"pokemon-cell name\\\">空位</div>\\n                        <div class=\\\"pokemon-cell level\\\">-</div>\\n                        <div class=\\\"pokemon-cell gender\\\">-</div>\\n                        <div class=\\\"pokemon-cell fusion\\\">-</div>\\n                        <div class=\\\"pokemon-cell nature\\\">-</div>\\n                        <div class=\\\"pokemon-cell type\\\">-</div>\\n                        <div class=\\\"pokemon-cell status\\\">-</div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- 物品标签页 -->\\n        <div id=\\\"items-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>物品背包</h2>\\n            \\n            <!-- 金钱显示 -->\\n            <div class=\\\"money-display\\\">\\n                <div class=\\\"money-label\\\">金钱:</div>\\n                <div class=\\\"money-amount\\\"></div>\\n                <div class=\\\"money-unit\\\">元</div>\\n            </div>\\n\\n            <!-- 物品列表 -->\\n            <div class=\\\"items-container\\\">\\n                <!-- 物品列表由JavaScript动态更新 -->\\n            </div>\\n        </div>\\n\\n        <!-- 目标标签页 -->\\n        <div id=\\\"goals-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>任务目标</h2>\\n            \\n            <div id=\\\"goals-container\\\" class=\\\"goals-container\\\">\\n                <!-- 目标列表由JavaScript动态更新 -->\\n            </div>\\n        </div>\\n\\n        <!-- 人际标签页 -->\\n        <div id=\\\"npc-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>人际关系</h2>\\n            \\n            <div class=\\\"social-list\\\">\\n                <div class=\\\"social-list-title\\\">认识的人物</div>\\n                <!-- NPC列表由JavaScript动态更新 -->\\n            </div>\\n        </div>\\n\\n        <!-- 设置标签页 -->\\n        <div id=\\\"settings-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>系统设置</h2>\\n            \\n            <div class=\\\"settings-container\\\">\\n                <!-- 字体设置 -->\\n                <div class=\\\"settings-card\\\">\\n                    <div class=\\\"settings-header\\\">\\n                        <i class=\\\"fas fa-font\\\"></i>\\n                        字体设置\\n                    </div>\\n                    <div class=\\\"settings-content\\\">\\n                        <div class=\\\"settings-group\\\">\\n                            <div class=\\\"settings-label\\\">选择字体</div>\\n                            <select id=\\\"fontSelector\\\" class=\\\"font-selector\\\">\\n                                <option value=\\\"Microsoft\\\">微软雅黑</option>\\n                                <option value=\\\"SourceHanSerif\\\">思源宋体</option>\\n                                <option value=\\\"LXGWWenKai\\\">霞鹜文楷</option>\\n                            </select>\\n                        </div>\\n                        \\n                        <div class=\\\"settings-group\\\">\\n                            <div class=\\\"settings-label\\\">字体大小: <span id=\\\"fontSizeValue\\\">16px</span></div>\\n                            <input type=\\\"range\\\" id=\\\"fontSizeSlider\\\" class=\\\"font-size-slider\\\" min=\\\"12\\\" max=\\\"24\\\" value=\\\"16\\\" step=\\\"1\\\">\\n                        </div>\\n                    </div>\\n                </div>\\n                \\n                <!-- 主题设置 -->\\n                <div class=\\\"settings-card\\\">\\n                    <div class=\\\"settings-header\\\">\\n                        <i class=\\\"fas fa-moon\\\"></i>\\n                        主题设置\\n                    </div>\\n                    <div class=\\\"settings-content\\\">\\n                        <div class=\\\"settings-group\\\">\\n                            <div class=\\\"settings-label\\\">夜间模式</div>\\n                            <div class=\\\"theme-switch\\\">\\n                                <label class=\\\"switch-label\\\">\\n                                    <input type=\\\"checkbox\\\" class=\\\"switch-input\\\" id=\\\"darkModeToggle\\\">\\n                                    <span class=\\\"switch-slider\\\"></span>\\n                                </label>\\n                                <span>启用夜间模式</span>\\n                            </div>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n            \\n            <div class=\\\"save-status\\\">\\n                <i class=\\\"fas fa-check-circle\\\"></i>\\n                设置已自动保存\\n            </div>\\n        </div>\\n    </div>\\n\\n    <!-- 底部导航栏 -->\\n    <div class=\\\"nav-container\\\">\\n        <div class=\\\"nav-buttons\\\">\\n            <button class=\\\"nav-button\\\" data-target=\\\"main-section\\\">正文</button>\\n            <button class=\\\"nav-button\\\" data-target=\\\"pokemon-section\\\">宝可梦</button>\\n            <button class=\\\"nav-button\\\" data-target=\\\"map-section\\\">地图</button>\\n            <button class=\\\"nav-button\\\" data-target=\\\"team-section\\\">队伍</button>\\n            <button class=\\\"nav-button\\\" data-target=\\\"items-section\\\">背包</button>\\n            <button class=\\\"nav-button\\\" data-target=\\\"goals-section\\\">目标</button>\\n            <button class=\\\"nav-button\\\" data-target=\\\"npc-section\\\">人际</button>\\n            <button class=\\\"nav-button\\\" data-target=\\\"settings-section\\\">设置</button>\\n        </div>\\n    </div>\\n\\n    <!-- 确认弹窗 -->\\n    <div id=\\\"confirmDialog\\\" class=\\\"confirm-dialog\\\">\\n        <div class=\\\"confirm-dialog-content\\\">\\n            <div id=\\\"confirmDialogMessage\\\" class=\\\"confirm-dialog-message\\\"></div>\\n            <div class=\\\"confirm-dialog-buttons\\\">\\n                <button id=\\\"confirmDialogConfirm\\\" class=\\\"confirm-button\\\">确定</button>\\n                <button id=\\\"confirmDialogCancel\\\" class=\\\"confirm-button cancel\\\">取消</button>\\n            </div>\\n        </div>\\n    </div>\\n\\n    <!-- 音效 -->\\n    <audio id=\\\"clickSound\\\" src=\\\"https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3\\\" preload=\\\"auto\\\"></audio>\\n\\n    <script>\\n        // 字体映射表\\n        const fontFamilyMap = {\\n            'Microsoft': \\\"'Microsoft YaHei Light', '等线', sans-serif\\\",\\n            'SourceHanSerif': \\\"'Source Han Serif CN', serif\\\",\\n            'LXGWWenKai': \\\"'LXGW WenKai', serif\\\"\\n        };\\n        \\n        // 加载设置函数\\n        function loadSettings() {\\n            try {\\n                const settings = JSON.parse(localStorage.getItem('gameSettings') || '{}');\\n                console.log('加载保存的设置:', settings);\\n                \\n                // 应用字体设置\\n                if (settings.font) {\\n                    const fontSelector = document.getElementById('fontSelector');\\n                    if (fontSelector) {\\n                        fontSelector.value = settings.font;\\n                    }\\n                    \\n                    const fontFamily = fontFamilyMap[settings.font];\\n                    if (fontFamily) {\\n                        applyFontSettings(fontFamily, settings.fontSize || 16);\\n                    }\\n                }\\n                \\n                // 应用字体大小设置\\n                if (settings.fontSize) {\\n                    const fontSizeSlider = document.getElementById('fontSizeSlider');\\n                    const fontSizeValue = document.getElementById('fontSizeValue');\\n                    \\n                    if (fontSizeSlider) {\\n                        fontSizeSlider.value = settings.fontSize;\\n                    }\\n                    \\n                    if (fontSizeValue) {\\n                        fontSizeValue.textContent = settings.fontSize + 'px';\\n                    }\\n                    \\n                    document.documentElement.style.setProperty('--text-font-size', settings.fontSize + 'px');\\n                }\\n                \\n                // 应用夜间模式设置\\n                if (settings.darkMode !== undefined) {\\n                    const darkModeToggle = document.getElementById('darkModeToggle');\\n                    if (darkModeToggle) {\\n                        darkModeToggle.checked = settings.darkMode;\\n                    }\\n                    \\n                    document.body.classList.toggle('dark-mode', settings.darkMode);\\n                }\\n            } catch (error) {\\n                console.error('加载设置时出错:', error);\\n            }\\n        }\\n        \\n        // 保存设置函数\\n        function saveSettings() {\\n            try {\\n                const settings = {\\n                    font: document.getElementById('fontSelector')?.value || 'Microsoft',\\n                    fontSize: parseInt(document.getElementById('fontSizeSlider')?.value || '16'),\\n                    darkMode: document.getElementById('darkModeToggle')?.checked || false\\n                };\\n                \\n                localStorage.setItem('gameSettings', JSON.stringify(settings));\\n                console.log('保存设置:', settings);\\n                \\n                // 显示保存状态\\n                const saveStatus = document.querySelector('.save-status');\\n                if (saveStatus) {\\n                    saveStatus.classList.add('show');\\n                    setTimeout(() => {\\n                        saveStatus.classList.remove('show');\\n                    }, 2000);\\n                }\\n            } catch (error) {\\n                console.error('保存设置时出错:', error);\\n            }\\n        }\\n        \\n        // 应用字体设置函数\\n        function applyFontSettings(fontFamily, fontSize) {\\n            console.log('应用字体设置:', fontFamily, fontSize + 'px');\\n            \\n            // 使用CSS变量全局设置字体\\n            document.documentElement.style.setProperty('--text-font-size', fontSize + 'px');\\n            document.documentElement.style.setProperty('--main-font-family', fontFamily);\\n            \\n            // 直接应用字体到关键元素，确保立即生效\\n            const contentElements = document.querySelectorAll('.story-content, .quest-desc, .info-value, .npc-info-value, .pokemon-cell, .item-name, .team-pokemon, .pokemon-basic-info div, .quest-title, .move-effect, .town-desc, .region-desc');\\n            \\n            contentElements.forEach(element => {\\n                if (element) {\\n                    element.style.fontFamily = fontFamily;\\n                    element.style.fontSize = fontSize + 'px';\\n                }\\n            });\\n        }\\n        \\n /**\\n * 宝可梦游戏数据管理器\\n * 负责游戏数据的处理、持久化和更新\\n * 包含数据提取、更新和保存等功能\\n */\\nclass GameDataManager {\\n    constructor() {\\n        this.gameData = null;\\n        this.isTestMode = !this.checkSTEnvironment();\\n        this.gameData = {\\n            basic: {\\n                time: \\\"\\\",\\n                location: \\\"\\\",\\n                money: 0\\n            },\\n            currentPokemon: null,\\n            team: [], // 宝可梦队伍\\n            inventory: {\\n                items: []\\n            },\\n            goals: [], // 目标列表\\n            npcs: []  // NPC列表\\n        };\\n    }\\n\\n    // 检查是否在ST环境\\n    checkSTEnvironment() {\\n        try {\\n            return typeof triggerSlashWithResult !== 'undefined' && \\n                   typeof getChatMessages !== 'undefined' &&\\n                   typeof setChatMessage !== 'undefined';\\n        } catch (error) {\\n            console.log('未检测到ST环境，启用测试模式');\\n            return false;\\n        }\\n    }\\n\\n    // 获取测试数据\\n    getTestData() {\\n        return {\\n            basic: {},\\n            currentPokemon: {},\\n            team: [],\\n            inventory: {\\n                items: [],\\n                money: 0\\n            },\\n            goals: [],\\n            npcs: []\\n        };\\n    }\\n\\n    // 获取当前消息ID\\n    async getCurrentMessageId() {\\n        if (this.isTestMode) {\\n            return 'test-message-id';\\n        }\\n        return await triggerSlashWithResult('/pass {{lastMessageId}}');\\n    }\\n\\n    // =====================================================\\n    // 加载之前的游戏数据\\n    // =====================================================\\n    async loadPreviousData() {\\n        try {\\n            const lastMessageId = await this.getCurrentMessageId();\\n            const messages = await getChatMessages(`0-${lastMessageId}`);\\n            const aiMessages = messages.filter(message => message.role === 'assistant');\\n            \\n            // 先尝试获取倒数第二条消息（上一条AI回复）\\n            const previousMessage = aiMessages[aiMessages.length - 2];\\n            if (previousMessage && previousMessage.data) {\\n                console.log('从上一条AI消息加载数据');\\n                return this.loadDataFromMessage(previousMessage);\\n            }\\n\\n            // 如果上一条消息没有数据，再尝试获取当前消息\\n            const currentMessage = await getChatMessages(lastMessageId);\\n            if (currentMessage && currentMessage[0] && currentMessage[0].data) {\\n                console.log('从当前消息加载数据');\\n                return this.loadDataFromMessage(currentMessage[0]);\\n            }\\n\\n            console.log('未找到有效的游戏数据');\\n            return false;\\n        } catch (error) {\\n            console.error('加载游戏数据失败:', error);\\n            return false;\\n        }\\n    }\\n\\n    // 处理消息数据\\n    loadDataFromMessage(message) {\\n        if (!message || !message.data) return false;\\n        \\n        this.gameData = {\\n            ...this.getTestData(),  // 基础数据结构\\n            ...message.data         // 合并已保存的数据\\n        };\\n        return true;\\n    }\\n\\n    // 保存游戏数据\\n    async saveData(messageId) {\\n        if (this.isTestMode) {\\n            console.log('测试模式：保存数据', this.gameData);\\n            return true;\\n        }\\n        try {\\n            const currentId = messageId || await this.getCurrentMessageId();\\n            await setChatMessage({data: this.gameData}, currentId, {refresh: 'none'});\\n            return true;\\n        } catch (error) {\\n            console.error('保存游戏数据失败:', error);\\n            return false;\\n        }\\n    }\\n\\n    // 数据提取器\\n    static DataExtractor = {\\n        // 提取主要文本内容\\n        extractMainContent(text) {\\n            const contentMatch = text.match(/<maintext>([\\\\s\\\\S]*?)<\\\\/maintext>/);\\n            if (!contentMatch) return null;\\n            return contentMatch[1].trim();\\n        },\\n        \\n        // 提取基本信息（时间和地点）\\n        extractBasicInformation(text) {\\n            const basicMatch = text.match(/<basic_information>([\\\\s\\\\S]*?)<\\\\/basic_information>/);\\n            if (!basicMatch) return null;\\n            \\n            const basicInfo = {};\\n            const lines = basicMatch[1].split('\\\\n').filter(line => line.trim());\\n            \\n            lines.forEach(line => {\\n                if (line.includes('时间|')) {\\n                    basicInfo.time = line.split('|')[1].trim();\\n                } else if (line.includes('地点|')) {\\n                    basicInfo.location = line.split('|')[1].trim();\\n                }\\n            });\\n            \\n            return basicInfo;\\n        },\\n        \\n        // 提取当前宝可梦信息\\n        extractCurrentPokemon(text) {\\n            const pokemonMatch = text.match(/<current_pokemon>([\\\\s\\\\S]*?)<\\\\/current_pokemon>/);\\n            if (!pokemonMatch) return null;\\n            \\n            const lines = pokemonMatch[1].split('\\\\n').filter(line => line.trim());\\n            let currentPokemon = null;\\n            let skills = [];\\n            \\n            lines.forEach(line => {\\n                if (line.includes('当前宝可梦|')) {\\n                    const parts = line.split('|');\\n                    if (parts.length >= 12) {\\n                        currentPokemon = {\\n                            name: parts[1].trim(),\\n                            level: parseInt(parts[2].trim()),\\n                            gender: parts[3].trim(),\\n                            fusion: parts[4].trim(),\\n                            nature: parts[5].trim(),\\n                            type: parts[6].trim(),\\n                            attack: parseInt(parts[7].trim()),\\n                            defense: parseInt(parts[8].trim()),\\n                            speed: parseInt(parts[9].trim()),\\n                            specialAttack: parseInt(parts[10].trim()),\\n                            specialDefense: parseInt(parts[11].trim()),\\n                            hp: parseInt(parts[12].trim())\\n                        };\\n                    }\\n                } else if (line.includes('当前宝可梦技能列表|')) {\\n                    const parts = line.split('|');\\n                    // 每4个元素为一组技能数据\\n                    for (let i = 1; i < parts.length; i += 5) {\\n                        if (parts[i] && parts[i].trim() !== \\\"\\\") {\\n                            skills.push({\\n                                name: parts[i].trim(),\\n                                type: parts[i+1] ? parts[i+1].trim() : \\\"\\\",\\n                                power: parts[i+2] ? parseInt(parts[i+2].trim()) : 0,\\n                                accuracy: parts[i+3] ? parseInt(parts[i+3].trim()) : 0,\\n                                effect: parts[i+4] ? parts[i+4].trim() : \\\"无\\\"\\n                            });\\n                        }\\n                    }\\n                } else if (line.includes('当前宝可梦状态|')) {\\n                    if (currentPokemon) {\\n                        currentPokemon.status = line.split('|')[1].trim();\\n                    }\\n                }\\n            });\\n            \\n            if (currentPokemon) {\\n                currentPokemon.skills = skills;\\n            }\\n            \\n            return currentPokemon;\\n        },\\n        \\n        // 提取队伍宝可梦信息\\n        extractTeam(text) {\\n            const teamMatch = text.match(/<team>([\\\\s\\\\S]*?)<\\\\/team>/);\\n            if (!teamMatch) return null;\\n            \\n            const lines = teamMatch[1].split('\\\\n').filter(line => line.trim());\\n            const teamChanges = [];\\n            \\n            lines.forEach(line => {\\n                if (line.includes('宝可梦队伍|')) {\\n                    const parts = line.split('|');\\n                    if (parts.length >= 5) { // 确保有足够的部分\\n                        const action = parts[1].trim();\\n                        const pokemonData = {\\n                            id: parts[2].trim(),\\n                            name: parts[3].trim(),\\n                            level: parseInt(parts[4].trim()),\\n                            gender: parts[5].trim(),\\n                            fusion: parts[6].trim(),\\n                            nature: parts[7].trim(),\\n                            type: parts[8].trim(),\\n                            attack: parseInt(parts[9].trim()),\\n                            defense: parseInt(parts[10].trim()),\\n                            speed: parseInt(parts[11].trim()),\\n                            specialAttack: parseInt(parts[12].trim()),\\n                            specialDefense: parseInt(parts[13].trim()),\\n                            hp: parseInt(parts[14].trim()),\\n                            status: parts[15].trim(),\\n                            skills: []\\n                        };\\n                        \\n                        // 从第16部分开始是技能\\n                        for (let i = 16; i < 20 && i < parts.length; i++) {\\n                            pokemonData.skills.push(parts[i].trim());\\n                        }\\n                        \\n                        teamChanges.push({\\n                            action: action,\\n                            pokemon: pokemonData\\n                        });\\n                    }\\n                }\\n            });\\n            \\n            return teamChanges;\\n        },\\n        \\n        // 提取物品信息\\n        extractItems(text) {\\n            const itemMatch = text.match(/<item>([\\\\s\\\\S]*?)<\\\\/item>/);\\n            if (!itemMatch) return null;\\n            \\n            const lines = itemMatch[1].split('\\\\n').filter(line => line.trim());\\n            const itemChanges = [];\\n            let moneyChange = null;\\n            \\n            lines.forEach(line => {\\n                if (line.includes('物品栏|')) {\\n                    const parts = line.split('|');\\n                    if (parts.length >= 4) {\\n                        itemChanges.push({\\n                            action: parts[1].trim(),\\n                            id: parts[2].trim(),\\n                            name: parts[3].trim(),\\n                            count: parseInt(parts[4].trim())\\n                        });\\n                    }\\n                } else if (line.includes('金钱|')) {\\n                    const parts = line.split('|');\\n                    if (parts.length >= 3) {\\n                        moneyChange = {\\n                            action: parts[1].trim(),\\n                            amount: parseInt(parts[2].trim())\\n                        };\\n                    }\\n                }\\n            });\\n            \\n            return { items: itemChanges, money: moneyChange };\\n        },\\n        \\n        // 提取目标信息\\n        extractGoals(text) {\\n            const goalMatch = text.match(/<goal>([\\\\s\\\\S]*?)<\\\\/goal>/);\\n            if (!goalMatch) return null;\\n            \\n            const lines = goalMatch[1].split('\\\\n').filter(line => line.trim());\\n            const goalChanges = [];\\n            \\n            lines.forEach(line => {\\n                if (line.includes('目标|')) {\\n                    const parts = line.split('|');\\n                    if (parts.length >= 4) {\\n                        goalChanges.push({\\n                            action: parts[1].trim(),\\n                            id: parts[2].trim(),\\n                            name: parts[3].trim(),\\n                            description: parts.length > 4 ? parts[4].trim() : \\\"\\\"\\n                        });\\n                    }\\n                }\\n            });\\n            \\n            return goalChanges;\\n        },\\n        \\n        // 提取NPC信息\\n        extractNPCs(text) {\\n            const npcMatch = text.match(/<npc>([\\\\s\\\\S]*?)<\\\\/npc>/);\\n            if (!npcMatch) return null;\\n            \\n            const lines = npcMatch[1].split('\\\\n').filter(line => line.trim());\\n            const npcChanges = [];\\n            \\n            lines.forEach(line => {\\n                if (line.includes('人际关系|')) {\\n                    const parts = line.split('|');\\n                    if (parts.length >= 8) {\\n                        const npcData = {\\n                            id: parts[2].trim(),\\n                            name: parts[3].trim(),\\n                            gender: parts[4].trim(),\\n                            age: parseInt(parts[5].trim()),\\n                            identity: parts[6].trim(),\\n                            relationship: parts[7].trim(),\\n                            nature: parts[8].trim(),\\n                            pokemons: []\\n                        };\\n                        \\n                        // 从第9部分开始是宝可梦\\n                        for (let i = 9; i < 15 && i < parts.length; i++) {\\n                            npcData.pokemons.push(parts[i].trim());\\n                        }\\n                        \\n                        npcChanges.push({\\n                            action: parts[1].trim(),\\n                            npc: npcData\\n                        });\\n                    }\\n                }\\n            });\\n            \\n            return npcChanges;\\n        },\\n        \\n        // 综合提取游戏文本中的所有数据\\n        extractAllData(gameText) {\\n            if (!gameText) return null;\\n            \\n            // 检查并提取<gametext>标签中的内容\\n            const gametextMatch = gameText.match(/<gametext>([\\\\s\\\\S]*?)<\\\\/gametext>/);\\n            const text = gametextMatch ? gametextMatch[1] : gameText.replace(/<gametext>|<\\\\/gametext>/g, '');\\n            \\n            return {\\n                mainContent: this.extractMainContent(text),\\n                basicInfo: this.extractBasicInformation(text),\\n                currentPokemon: this.extractCurrentPokemon(text),\\n                teamChanges: this.extractTeam(text),\\n                itemChanges: this.extractItems(text),\\n                goalChanges: this.extractGoals(text),\\n                npcChanges: this.extractNPCs(text)\\n            };\\n        }\\n    };\\n\\n    // 主要的数据处理流程\\n    async processGameData() {\\n        try {\\n            // 1. 加载上一条AI消息的数据\\n            const dataLoaded = await this.loadPreviousData();\\n            if (!dataLoaded) {\\n                console.log('没有找到之前的游戏数据，使用初始数据');\\n                this.gameData = this.getTestData();\\n            }\\n\\n            // 定义游戏文本（示例格式）\\n            let gameText = `<gametext>$1</gametext>`;\\n            // 注意：实际使用时，需要将上面的示例替换为实际的游戏文本\\n\\n            // 2. 从游戏文本中提取数据\\n            const extractedData = GameDataManager.DataExtractor.extractAllData(gameText);\\n            if (!extractedData) {\\n                console.error('无法从游戏文本中提取数据');\\n                return false;\\n            }\\n\\n            console.log('提取的数据:', extractedData);\\n\\n            // 3. 处理主要文本内容\\n            if (extractedData.mainContent) {\\n                this.gameData.mainContent = extractedData.mainContent;\\n                console.log('更新主要内容:', this.gameData.mainContent);\\n                \\n                // 如果有UI更新功能，在这里调用\\n                if (window.contentManager) {\\n                    window.contentManager.updateContent(this.gameData.mainContent);\\n                }\\n            }\\n\\n            // 4. 处理基本信息（时间和地点）\\n            if (extractedData.basicInfo) {\\n                if (extractedData.basicInfo.time) {\\n                    this.gameData.basic.time = extractedData.basicInfo.time;\\n                }\\n                if (extractedData.basicInfo.location) {\\n                    this.gameData.basic.location = extractedData.basicInfo.location;\\n                }\\n                console.log('更新基本信息:', this.gameData.basic);\\n                \\n                // 更新环境UI\\n                if (window.environmentManager) {\\n                    window.environmentManager.updateEnvironment(this.gameData.basic);\\n                }\\n            }\\n\\n            // 5. Update the current Pokemon\\n            if (extractedData.currentPokemon) {\\n                this.gameData.currentPokemon = extractedData.currentPokemon;\\n                console.log('更新当前宝可梦:', this.gameData.currentPokemon);\\n                \\n                // 更新宝可梦UI\\n                if (window.pokemonPanel) {\\n                    window.pokemonPanel.updateCurrentPokemon(this.gameData.currentPokemon);\\n                }\\n            }\\n\\n            // 6. Handle team changes\\n            if (extractedData.teamChanges && extractedData.teamChanges.length > 0) {\\n                this.updateTeam(extractedData.teamChanges);\\n            }\\n\\n            // 7. Handle item changes\\n            if (extractedData.itemChanges) {\\n                if (extractedData.itemChanges.items && extractedData.itemChanges.items.length > 0) {\\n                    this.updateInventory(extractedData.itemChanges.items);\\n                }\\n                \\n                if (extractedData.itemChanges.money) {\\n                    this.updateMoney(extractedData.itemChanges.money);\\n                }\\n            }\\n\\n            // 8. Handle goal changes\\n            if (extractedData.goalChanges && extractedData.goalChanges.length > 0) {\\n                this.updateGoals(extractedData.goalChanges);\\n            }\\n\\n            // 9. Handle NPC changes\\n            if (extractedData.npcChanges && extractedData.npcChanges.length > 0) {\\n                this.updateNPCs(extractedData.npcChanges);\\n            }\\n\\n            // 10. 保存更新后的数据\\n            const currentId = await this.getCurrentMessageId();\\n            await this.saveData(currentId);\\n\\n            return true;\\n        } catch (error) {\\n            console.error('处理游戏数据失败:', error);\\n            return false;\\n        }\\n    }\\n\\n    // 更新宝可梦队伍\\n    updateTeam(teamChanges) {\\n        if (!this.gameData.team) {\\n            this.gameData.team = [];\\n        }\\n\\n        teamChanges.forEach(change => {\\n            const { action, pokemon } = change;\\n            if (!pokemon) return;\\n\\n            // 处理宝可梦变化\\n            if (action === '新增') {\\n                // 检查是否已存在该宝可梦\\n                const existingIndex = this.gameData.team.findIndex(p => p.id === pokemon.id);\\n                if (existingIndex !== -1) {\\n                    // 已存在则更新数据\\n                    this.gameData.team[existingIndex] = pokemon;\\n                } else {\\n                    // 不存在则添加\\n                    this.gameData.team.push(pokemon);\\n                }\\n                \\n                // 显示宝可梦获得通知\\n                if (window.notificationManager) {\\n                    window.notificationManager.showNotification('pokemon', {\\n                        action: '获得',\\n                        pokemon: pokemon\\n                    });\\n                }\\n            } else if (action === '删除') {\\n                // 从队伍中移除宝可梦\\n                this.gameData.team = this.gameData.team.filter(p => p.id !== pokemon.id);\\n                \\n                // 显示宝可梦删除通知\\n                if (window.notificationManager) {\\n                    window.notificationManager.showNotification('pokemon', {\\n                        action: '失去',\\n                        pokemon: pokemon\\n                    });\\n                }\\n            }\\n        });\\n\\n        console.log('更新队伍后:', this.gameData.team);\\n        \\n        // 更新UI\\n        if (window.teamManager) {\\n            window.teamManager.updateTeam(this.gameData.team);\\n        }\\n        \\n        // 保存更改\\n        this.saveData();\\n    }\\n\\n    // 更新物品库存\\n    updateInventory(itemChanges) {\\n        if (!this.gameData.inventory) {\\n            this.gameData.inventory = {\\n                items: []\\n            };\\n        }\\n\\n        itemChanges.forEach(item => {\\n            const { action, id, name, count } = item;\\n            if (!name) return;\\n\\n            // 查找已有物品\\n            const existingItemIndex = this.gameData.inventory.items.findIndex(i => i.id === id);\\n            \\n            if (action === '获取') {\\n                if (existingItemIndex !== -1) {\\n                    // 已有物品，增加数量\\n                    this.gameData.inventory.items[existingItemIndex].count += count;\\n                } else {\\n                    // 新物品，添加到库存\\n                    this.gameData.inventory.items.push({\\n                        id,\\n                        name,\\n                        count\\n                    });\\n                }\\n                \\n                // 显示物品获得通知\\n                if (window.notificationManager) {\\n                    window.notificationManager.showNotification('item', {\\n                        action: '获得',\\n                        item: { name, count }\\n                    });\\n                }\\n            } else if (action === '失去') {\\n                if (existingItemIndex !== -1) {\\n                    // 减少物品数量\\n                    this.gameData.inventory.items[existingItemIndex].count -= count;\\n                    \\n                    // 如果数量为0或负数，从库存中移除\\n                    if (this.gameData.inventory.items[existingItemIndex].count <= 0) {\\n                        this.gameData.inventory.items.splice(existingItemIndex, 1);\\n                    }\\n                    \\n                    // 显示物品失去通知\\n                    if (window.notificationManager) {\\n                        window.notificationManager.showNotification('item', {\\n                            action: '失去',\\n                            item: { name, count }\\n                        });\\n                    }\\n                }\\n            }\\n        });\\n\\n        console.log('更新物品后:', this.gameData.inventory.items);\\n        \\n        // 更新UI\\n        if (window.inventoryManager) {\\n            window.inventoryManager.updateInventory(this.gameData.inventory.items, this.gameData.inventory.money);\\n        }\\n        \\n        // 保存更改\\n        this.saveData();\\n    }\\n\\n    // 更新金钱\\n    updateMoney(moneyChange) {\\n        if (!moneyChange) return;\\n        \\n        if (!this.gameData.inventory) {\\n            this.gameData.inventory = { money: 0 };\\n        } else if (typeof this.gameData.inventory.money !== 'number') {\\n            this.gameData.inventory.money = 0;\\n        }\\n        \\n        const { action, amount } = moneyChange;\\n        \\n        if (action === '获取') {\\n            this.gameData.inventory.money += amount;\\n        } else if (action === '失去') {\\n            this.gameData.inventory.money = Math.max(0, this.gameData.inventory.money - amount);\\n        }\\n\\n        console.log('更新金钱后:', this.gameData.inventory.money);\\n        \\n        // 显示金钱变动通知\\n        if (window.notificationManager) {\\n            window.notificationManager.showNotification('money', {\\n                action: action === '获取' ? '获得' : '消耗',\\n                amount: amount\\n            });\\n        }\\n        \\n        // 更新UI\\n        if (window.moneyDisplay) {\\n            window.moneyDisplay.updateMoney(this.gameData.inventory.money);\\n        }\\n        \\n        // 保存更改\\n        this.saveData();\\n    }\\n\\n    // 更新目标\\n    updateGoals(goalChanges) {\\n        if (!this.gameData.goals) {\\n            this.gameData.goals = [];\\n        }\\n\\n        goalChanges.forEach(goal => {\\n            const { action, id, name, description } = goal;\\n            \\n            if (action === '新增') {\\n                // 检查是否已存在该目标\\n                const existingIndex = this.gameData.goals.findIndex(g => g.id === id);\\n                if (existingIndex !== -1) {\\n                    // 已存在则更新描述\\n                    this.gameData.goals[existingIndex].description = description;\\n                } else {\\n                    // 不存在则添加\\n                    this.gameData.goals.push({\\n                        id,\\n                        name,\\n                        description\\n                    });\\n                    \\n                    // 显示目标获得通知\\n                    if (window.notificationManager) {\\n                        window.notificationManager.showNotification('goal', {\\n                            action: '新增',\\n                            goal: { name, description }\\n                        });\\n                    }\\n                }\\n            } else if (action === '删除') {\\n                // 从目标列表中移除\\n                this.gameData.goals = this.gameData.goals.filter(g => g.id !== id);\\n                \\n                // 显示目标完成通知\\n                if (window.notificationManager) {\\n                    window.notificationManager.showNotification('goal', {\\n                        action: '完成',\\n                        goal: { name }\\n                    });\\n                }\\n            }\\n        });\\n\\n        console.log('更新目标后:', this.gameData.goals);\\n        \\n        // 更新UI\\n        if (window.goalManager) {\\n            window.goalManager.updateGoals(this.gameData.goals);\\n        }\\n        \\n        // 保存更改\\n        this.saveData();\\n    }\\n\\n    // 更新NPC\\n    updateNPCs(npcChanges) {\\n        if (!this.gameData.npcs) {\\n            this.gameData.npcs = [];\\n        }\\n\\n        npcChanges.forEach(change => {\\n            const { action, npc } = change;\\n            if (!npc) return;\\n            \\n            if (action === '新增') {\\n                // 检查是否已存在该NPC\\n                const existingIndex = this.gameData.npcs.findIndex(n => n.id === npc.id);\\n                if (existingIndex !== -1) {\\n                    // 已存在则更新数据\\n                    this.gameData.npcs[existingIndex] = npc;\\n                } else {\\n                    // 不存在则添加\\n                    this.gameData.npcs.push(npc);\\n                }\\n            } else if (action === '删除') {\\n                // 从NPC列表中移除\\n                this.gameData.npcs = this.gameData.npcs.filter(n => n.id !== npc.id);\\n            }\\n        });\\n\\n        console.log('更新NPC后:', this.gameData.npcs);\\n        \\n        // 更新UI\\n        if (window.npcManager) {\\n            window.npcManager.updateNPCs(this.gameData.npcs);\\n        }\\n        \\n        // 保存更改\\n        this.saveData();\\n    }\\n\\n    // 辅助方法：解析效果字符串\\n    parseEffects(effects) {\\n        if (!effects) return null;\\n        \\n        // 尝试解析属性影响，例如\\\"攻击+2 速度+1\\\"\\n        const effectsObj = {};\\n        const effectRegex = /(\\\\S+)([\\\\+\\\\-])(\\\\d+)/g;\\n        let match;\\n        \\n        while ((match = effectRegex.exec(effects)) !== null) {\\n            const attribute = match[1];\\n            const sign = match[2] === '+' ? 1 : -1;\\n            const value = parseInt(match[3]) * sign;\\n            effectsObj[attribute] = value;\\n        }\\n        \\n        return Object.keys(effectsObj).length > 0 ? effectsObj : effects;\\n    }\\n\\n    // 宝可梦属性映射\\n    static AttributeMap = {\\n        // 英文到中文\\n        'attack': '攻击',\\n        'defense': '防御',\\n        'speed': '速度',\\n        'specialAttack': '特攻',\\n        'specialDefense': '特防',\\n        'hp': '生命值',\\n        // 中文到英文\\n        '攻击': 'attack',\\n        '防御': 'defense',\\n        '速度': 'speed',\\n        '特攻': 'specialAttack',\\n        '特防': 'specialDefense',\\n        '生命值': 'hp',\\n        // 获取显示名称的方法\\n        getDisplayName(attr) {\\n            return this[attr] || attr;\\n        }\\n    };\\n\\n    // 物品品质映射\\n    static QualityMap = {\\n        // 英文到中文\\n        'common': {\\n            name: '普通',\\n            color: '#ffffff'\\n        },\\n        'uncommon': {\\n            name: '优秀',\\n            color: '#1eff00'\\n        },\\n        'rare': {\\n            name: '稀有',\\n            color: '#0070dd'\\n        },\\n        'epic': {\\n            name: '史诗',\\n            color: '#a335ee'\\n        },\\n        'legendary': {\\n            name: '传说',\\n            color: '#ff8000'\\n        },\\n        // 中文到英文的反向映射\\n        '普通': 'common',\\n        '优秀': 'uncommon',\\n        '稀有': 'rare',\\n        '史诗': 'epic',\\n        '传说': 'legendary',\\n        // 获取显示信息的方法\\n        getDisplayInfo(quality) {\\n            if (this[quality]) {\\n                if (typeof this[quality] === 'object') {\\n                    return this[quality];\\n                } else {\\n                    return this[this[quality]];\\n                }\\n            }\\n            return {\\n                name: quality,\\n                color: '#ffffff'\\n            };\\n        }\\n    };\\n\\n    // 初始化方法\\n    // 完成整个游戏数据管理器的初始化流程\\n    async initialize() {\\n        try {\\n            if (this.isTestMode) {\\n                console.log('非ST环境：使用测试数据');\\n                this.gameData = this.getTestData();\\n                return;\\n            }\\n\\n            // 1. 先初始化基础数据结构\\n            this.gameData = {\\n                basic: {\\n                    time: \\\"\\\",\\n                    location: \\\"\\\",\\n                    money: 0\\n                },\\n                currentPokemon: null,\\n                team: [],\\n                inventory: {\\n                    items: []\\n                },\\n                goals: [],\\n                npcs: []\\n            };\\n\\n            // 2. 加载历史数据\\n            const dataLoaded = await this.loadPreviousData();\\n            if (dataLoaded) {\\n                console.log('成功加载历史数据');\\n            } else {\\n                // 如果没有历史数据，则使用测试数据\\n                this.gameData = this.getTestData();\\n                console.log('使用测试数据初始化游戏');\\n            }\\n\\n            // 3. 处理游戏数据 - 从当前游戏文本中提取数据并更新\\n            await this.processGameData();\\n\\n            // 4. 保存更新后的数据\\n            const currentId = await this.getCurrentMessageId();\\n            await this.saveData(currentId);\\n\\n            console.log('游戏数据初始化完成');\\n            \\n            // 触发初始化完成事件，通知UI更新\\n            const event = new CustomEvent('gameDataManagerReady');\\n            window.dispatchEvent(event);\\n            \\n        } catch (error) {\\n            console.error('初始化游戏数据时出错:', error);\\n            // 出错时使用测试数据\\n            this.gameData = this.getTestData();\\n            \\n            // 即使出错也触发事件，使用测试数据更新UI\\n            const event = new CustomEvent('gameDataManagerReady');\\n            window.dispatchEvent(event);\\n        }\\n    }\\n}\\n\\n// 创建全局实例并自动初始化\\nwindow.gameDataManager = new GameDataManager();\\n\\n// 内容管理器 - 负责更新主内容区域\\nclass ContentManager {\\n    constructor() {\\n        this.contentElement = document.querySelector('.story-content');\\n    }\\n    \\n    updateContent(content) {\\n        if (this.contentElement && content) {\\n            this.contentElement.innerHTML = content;\\n        }\\n    }\\n}\\n\\n// 环境管理器 - 负责更新时间和地点信息\\nclass EnvironmentManager {\\n    constructor() {\\n        this.timeElement = document.querySelector('.info-row .time');\\n        this.locationElement = document.querySelector('.info-row .location');\\n    }\\n    \\n    updateEnvironment(basicInfo) {\\n        if (this.timeElement && basicInfo.time) {\\n            this.timeElement.textContent = basicInfo.time;\\n        }\\n        \\n        if (this.locationElement && basicInfo.location) {\\n            // 分割地点信息，例如：\\\"关都地区-常青市-宝可梦中心\\\"\\n            const locations = basicInfo.location.split('-');\\n            this.locationElement.innerHTML = '';\\n            \\n            locations.forEach((loc, index) => {\\n                const span = document.createElement('span');\\n                span.textContent = loc;\\n                this.locationElement.appendChild(span);\\n            });\\n        }\\n    }\\n}\\n\\n// 宝可梦管理器 - 负责更新当前宝可梦信息\\nclass PokemonManager {\\n    constructor() {\\n        this.basicInfoContainer = document.querySelector('.pokemon-basic-info');\\n        this.statsContainer = document.querySelector('.pokemon-stats');\\n        this.movesContainer = document.querySelector('.pokemon-moves');\\n        this.statusContainer = document.querySelector('.pokemon-status');\\n    }\\n    \\n    updateCurrentPokemon(pokemon) {\\n        if (!pokemon) return;\\n        \\n        // 更新基本信息\\n        if (this.basicInfoContainer) {\\n            this.basicInfoContainer.innerHTML = `\\n             