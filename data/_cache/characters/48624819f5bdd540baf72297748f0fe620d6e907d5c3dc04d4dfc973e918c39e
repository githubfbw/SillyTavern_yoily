t-size: 8px;\\n                padding: 3px 1px;\\n            }\\n        }\\n    </style>\\n</head>\\n<body>\\n    <!-- 内容区域 -->\\n    <div class=\\\"content-container\\\">\\n        <!-- 正文标签页 -->\\n        <div id=\\\"main-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>游戏正文</h2>\\n            \\n            <!-- 基本信息区域 -->\\n            <div class=\\\"basic-info\\\">\\n                <div class=\\\"info-row\\\">\\n                    <div class=\\\"info-item\\\">\\n                        <span class=\\\"info-label\\\">时间:</span>\\n                        <span class=\\\"info-value time\\\"></span>\\n                    </div>\\n                    <div class=\\\"info-item\\\">\\n                        <span class=\\\"info-label\\\">地点:</span>\\n                        <span class=\\\"info-value location\\\"></span>\\n                    </div>\\n                </div>\\n            </div>\\n            \\n            <!-- 故事内容区域 -->\\n            <div class=\\\"story-content\\\"></div>\\n        </div>\\n\\n        <!-- 宝可梦标签页 -->\\n        <div id=\\\"pokemon-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>当前宝可梦</h2>\\n            \\n            <!-- 宝可梦基本信息 -->\\n            <div class=\\\"pokemon-basic-info\\\"></div>\\n            \\n            <!-- 宝可梦属性 -->\\n            <div class=\\\"section-title\\\">能力值</div>\\n            <div class=\\\"pokemon-stats\\\"></div>\\n            \\n            <!-- 宝可梦技能 -->\\n            <div class=\\\"section-title\\\">技能列表</div>\\n            <div class=\\\"pokemon-moves\\\"></div>\\n            \\n            <!-- 宝可梦状态 -->\\n            <div class=\\\"section-title\\\">状态</div>\\n            <div class=\\\"pokemon-status\\\"></div>\\n        </div>\\n\\n        <!-- 地图标签页 -->\\n        <div id=\\\"map-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>地区地图</h2>\\n            \\n            <!-- 地区选择界面 -->\\n            <div class=\\\"region-buttons\\\">\\n                <div class=\\\"region-button\\\" data-region=\\\"kanto\\\">\\n                    <div class=\\\"region-name\\\">关都地区</div>\\n                    <div class=\\\"region-desc\\\">最早的宝可梦地区，包含常青市、华蓝市等8个主要城市。</div>\\n                </div>\\n                <div class=\\\"region-button\\\" data-region=\\\"johto\\\">\\n                    <div class=\\\"region-name\\\">城都地区</div>\\n                    <div class=\\\"region-desc\\\">与关都相邻的地区，有着丰富的传统文化和传说。</div>\\n                </div>\\n                <div class=\\\"region-button\\\" data-region=\\\"hoenn\\\">\\n                    <div class=\\\"region-name\\\">丰缘地区</div>\\n                    <div class=\\\"region-desc\\\">由海洋环绕的岛屿地区，有着多样的自然环境。</div>\\n                </div>\\n                <div class=\\\"region-button\\\" data-region=\\\"sinnoh\\\">\\n                    <div class=\\\"region-name\\\">神奥地区</div>\\n                    <div class=\\\"region-desc\\\">北方的寒冷地区，有着创世神话和时空传说。</div>\\n                </div>\\n            </div>\\n\\n            <!-- 关都地区详细页面 -->\\n            <div class=\\\"region-detail\\\" id=\\\"kanto-detail\\\">\\n                <div class=\\\"region-header\\\">\\n                    <button class=\\\"back-button\\\">← 返回</button>\\n                    <h3 class=\\\"region-name\\\">关都地区</h3>\\n                </div>\\n                <div class=\\\"town-grid\\\">\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">真新镇</div>\\n                        <div class=\\\"town-desc\\\">你的故乡，大木博士的研究所所在地。这里环境宁静，是许多训练家的起点。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">常青市</div>\\n                        <div class=\\\"town-desc\\\">拥有小刚的岩石系道馆，可以获得灰色徽章。城市建在山脉之间，以采矿业闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">华蓝市</div>\\n                        <div class=\\\"town-desc\\\">拥有小霞的水系道馆，可以获得蓝色徽章。这座沿海城市有着美丽的海滩和灯塔。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">枯叶市</div>\\n                        <div class=\\\"town-desc\\\">拥有马志士的电系道馆，可以获得雷霆徽章。这里曾是军事基地，现在是繁华的商业中心。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">紫苑镇</div>\\n                        <div class=\\\"town-desc\\\">有着著名的宝可梦塔，是悼念逝去宝可梦的圣地。这里常年弥漫着神秘的氛围。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">浅红市</div>\\n                        <div class=\\\"town-desc\\\">拥有娜姿的超能力道馆，可以获得沼泽徽章。这座城市以其未来科技和精神力研究闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">红莲镇</div>\\n                        <div class=\\\"town-desc\\\">位于活火山附近的小镇，附近有着火箭队的秘密基地。这里的温泉吸引了许多游客。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">金黄市</div>\\n                        <div class=\\\"town-desc\\\">拥有小南的格斗系道馆，可以获得彩虹徽章。这座城市是关都地区的商业和娱乐中心。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">深灰市</div>\\n                        <div class=\\\"town-desc\\\">拥有阿桔的毒系道馆，可以获得火山徽章。这座工业城市有着严重的环境问题。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">石英高原</div>\\n                        <div class=\\\"town-desc\\\">宝可梦联盟总部所在地，四天王和冠军在此接受挑战。这里是每个训练家的最终目标。</div>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- 城都地区详细页面 -->\\n            <div class=\\\"region-detail\\\" id=\\\"johto-detail\\\">\\n                <div class=\\\"region-header\\\">\\n                    <button class=\\\"back-button\\\">← 返回</button>\\n                    <h3 class=\\\"region-name\\\">城都地区</h3>\\n                </div>\\n                <div class=\\\"town-grid\\\">\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">若叶镇</div>\\n                        <div class=\\\"town-desc\\\">城都地区的小镇，有着榆树博士的研究所。这里环境优美，是新训练家的起点。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">桔梗市</div>\\n                        <div class=\\\"town-desc\\\">拥有阿笛的飞行系道馆，可以获得飞翔徽章。这座城市以其古老的钟楼闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">卡吉镇</div>\\n                        <div class=\\\"town-desc\\\">一个宁静的小镇，有着著名的慢跑鞋商店。这里的居民热爱运动和自然。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">达摩市</div>\\n                        <div class=\\\"town-desc\\\">拥有小刚的格斗系道馆，可以获得拳击徽章。这座城市以武术传统和格斗训练闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">翠绿市</div>\\n                        <div class=\\\"town-desc\\\">拥有小茜的草系道馆，可以获得植物徽章。这座城市被茂密的森林环绕，充满生机。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">满金市</div>\\n                        <div class=\\\"town-desc\\\">城都地区最大的城市，有着无线电塔。这里是商业和文化中心，繁华热闹。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">烟墨市</div>\\n                        <div class=\\\"town-desc\\\">拥有阿四的幽灵系道馆，可以获得雾徽章。这座城市充满传统文化，有着凤王传说。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">浅黄市</div>\\n                        <div class=\\\"town-desc\\\">拥有小椿的冰系道馆，可以获得冰晶徽章。这座重要的港口城市有着著名的灯塔。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">深灰市</div>\\n                        <div class=\\\"town-desc\\\">拥有小刚的钢系道馆，可以获得矿石徽章。这座位于岛屿上的城市以钢铁工业闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">红叶镇</div>\\n                        <div class=\\\"town-desc\\\">一个位于山区的小镇，附近有愤怒之湖。这里的枫叶在秋季特别美丽，吸引许多游客。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">黑松市</div>\\n                        <div class=\\\"town-desc\\\">拥有小椿的龙系道馆，可以获得上升徽章。这座位于山脉中的城市以龙系训练家闻名。</div>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- 丰缘地区详细页面 -->\\n            <div class=\\\"region-detail\\\" id=\\\"hoenn-detail\\\">\\n                <div class=\\\"region-header\\\">\\n                    <button class=\\\"back-button\\\">← 返回</button>\\n                    <h3 class=\\\"region-name\\\">丰缘地区</h3>\\n                </div>\\n                <div class=\\\"town-grid\\\">\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">绿荫镇</div>\\n                        <div class=\\\"town-desc\\\">丰缘地区的小镇，大木博士的研究所所在地。这里环境宜人，是新训练家的起点。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">古辰镇</div>\\n                        <div class=\\\"town-desc\\\">一个历史悠久的小镇，有着古老的遗迹。这里保存着许多关于远古宝可梦的传说。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">橙华市</div>\\n                        <div class=\\\"town-desc\\\">拥有千里的普通系道馆，可以获得普通徽章。这座城市以其美丽的花园和公园闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">卡那兹市</div>\\n                        <div class=\\\"town-desc\\\">拥有铁旋的岩石系道馆，可以获得岩石徽章。这座现代化城市有着得文公司总部。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">武斗镇</div>\\n                        <div class=\\\"town-desc\\\">拥有藤树的格斗系道馆，可以获得拳击徽章。这座位于岛屿上的小镇以格斗训练和冲浪闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">凯那市</div>\\n                        <div class=\\\"town-desc\\\">拥有电次的电系道馆，可以获得电力徽章。这座重要的港口城市有着热闹的市场。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">紫堇市</div>\\n                        <div class=\\\"town-desc\\\">拥有亚莎的火系道馆，可以获得热力徽章。这座充满活力的城市是丰缘地区的文化中心。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">茵郁市</div>\\n                        <div class=\\\"town-desc\\\">拥有娜琪的草系道馆，可以获得平衡徽章。这座建在树上的城市是一座独特的空中城市。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">水静市</div>\\n                        <div class=\\\"town-desc\\\">拥有米可利的水系道馆，可以获得雨滴徽章。这座美丽的海滨城市有着大型百货公司。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">琉璃市</div>\\n                        <div class=\\\"town-desc\\\">拥有亚当的超能力道馆，可以获得心灵徽章。这座建在火山口中的城市是一座独特的水上城市。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">绿岭市</div>\\n                        <div class=\\\"town-desc\\\">拥有源治的冰系道馆，可以获得冰冻徽章。这座位于北方的城市终年被雪覆盖。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">暮水镇</div>\\n                        <div class=\\\"town-desc\\\">拥有米可利的龙系道馆，可以获得龙之徽章。这座神秘的小镇与龙族有着深厚的渊源。</div>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- 神奥地区详细页面 -->\\n            <div class=\\\"region-detail\\\" id=\\\"sinnoh-detail\\\">\\n                <div class=\\\"region-header\\\">\\n                    <button class=\\\"back-button\\\">← 返回</button>\\n                    <h3 class=\\\"region-name\\\">神奥地区</h3>\\n                </div>\\n                <div class=\\\"town-grid\\\">\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">双叶镇</div>\\n                        <div class=\\\"town-desc\\\">神奥地区南部的宁静小镇，是新训练家的起点。这里环境优美，靠近湖泊。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">真砂镇</div>\\n                        <div class=\\\"town-desc\\\">有着罗安博士的研究所，靠近海边。这座小镇以其美丽的沙滩和宝可梦研究闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">祝庆市</div>\\n                        <div class=\\\"town-desc\\\">拥有小菘的草系道馆，可以获得森林徽章。这座神奥地区最大的城市是电视台总部所在地。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">矿石镇</div>\\n                        <div class=\\\"town-desc\\\">拥有大叔的岩石系道馆，可以获得煤炭徽章。这座小镇以其采矿业和岩石系宝可梦闻名。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">花苑镇</div>\\n                        <div class=\\\"town-desc\\\">一个被美丽花田环绕的小镇，以蜂蜜闻名。这里的居民热爱自然和花卉种植。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">永恒市</div>\\n                        <div class=\\\"town-desc\\\">拥有莉佳的幽灵系道馆，可以获得雾之徽章。这座城市有着神秘的雕像和古老的传说。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">缘之市</div>\\n                        <div class=\\\"town-desc\\\">拥有小菊儿的水系道馆，可以获得水滴徽章。这座时尚之都是神奥地区的文化中心。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">天冠镇</div>\\n                        <div class=\\\"town-desc\\\">一个以其古老遗迹和育儿屋闻名的小镇。这里保存着许多关于创世神话的传说。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">百代市</div>\\n                        <div class=\\\"town-desc\\\">拥有阿玛琳的格斗系道馆，可以获得拳击徽章。这座城市有着大型购物中心和现代设施。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">雪峰市</div>\\n                        <div class=\\\"town-desc\\\">拥有小刚的钢系道馆，可以获得矿石徽章。这座位于神奥地区最北端的城市终年被雪覆盖。</div>\\n                    </div>\\n                    <div class=\\\"town-button\\\">\\n                        <div class=\\\"town-name\\\">神和镇</div>\\n                        <div class=\\\"town-desc\\\">一个与神话传说有关的小镇，附近有着时空之塔。这里是通往神奥地区最高峰的入口。</div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- 队伍标签页 -->\\n        <div id=\\\"team-section\\\" class=\\\"tab-content content-section\\\">\\n            <h2>宝可梦队伍</h2>\\n            \\n            <div class=\\\"team-list\\\">\\n                <div class=\\\"team-list-title\\\">当前队伍</div>\\n                <div class=\\\"team-container\\\">\\n                    <!-- 队伍中的宝可梦 -->\\n                    <div class=\\\"team-pokemon\\\">\\n                        <div clas