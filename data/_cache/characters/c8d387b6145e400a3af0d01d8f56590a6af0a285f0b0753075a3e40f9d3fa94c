ght: 8px; transform: rotate(-45deg); }\\n        .section-container:hover::before,\\n        .section-container:hover::after { opacity: 1; }\\n\\n        .section-container h4 {\\n            color: var(--title-color);\\n            margin: 0 0 12px 0;\\n            padding-bottom: 8px;\\n            border-bottom: 2px solid transparent;\\n            border-image: linear-gradient(to right, var(--title-color) 60%, transparent 100%) 1;\\n            font-size: 1.1em;\\n            font-weight: 600;\\n            display: flex;\\n            align-items: center;\\n            transition: color var(--transition-speed) ease;\\n        }\\n        .section-container:hover h4 {\\n            color: var(--highlight-color);\\n            border-image: linear-gradient(to right, var(--highlight-color) 60%, transparent 100%) 1;\\n        }\\n        .section-container h4 i.fa {\\n            margin-right: 10px;\\n            color: var(--highlight-color);\\n            font-size: 1.1em;\\n            width: 1.4em;\\n            text-align: center;\\n            transition: transform var(--transition-speed) ease, color var(--transition-speed) ease, text-shadow var(--transition-speed) ease;\\n            animation: iconPulse 3s infinite ease-in-out;\\n            animation-delay: calc(var(--animation-order, 0) * 0.1s);\\n        }\\n        .section-container:hover h4 i.fa {\\n            transform: scale(1.2) rotate(5deg);\\n            color: var(--title-color);\\n            text-shadow: 0 0 8px var(--glow-color);\\n        }\\n        @keyframes iconPulse {\\n            0%, 100% { transform: scale(1); opacity: 0.8; }\\n            50% { transform: scale(1.05); opacity: 1; }\\n        }\\n\\n        .section-content {\\n            white-space: pre-wrap; /* 保持换行和空格 */\\n            font-size: 0.98em;\\n            color: var(--text-color);\\n            padding-left: 8px;\\n            word-wrap: break-word; /* 允许长单词换行 */\\n            overflow-wrap: break-word; /* 同上，更现代的写法