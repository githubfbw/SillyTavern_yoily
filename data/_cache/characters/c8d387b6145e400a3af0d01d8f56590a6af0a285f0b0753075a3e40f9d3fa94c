iner:nth-child(2) h4 i.fa { --animation-order: 2; }\\n        .section-container:nth-child(3) h4 i.fa { --animation-order: 3; }\\n        .section-container:nth-child(4) h4 i.fa { --animation-order: 4; }\\n        .section-container:nth-child(5) h4 i.fa { --animation-order: 5; }\\n        .section-container:nth-child(6) h4 i.fa { --animation-order: 6; }\\n        .section-container:nth-child(7) h4 i.fa { --animation-order: 7; }\\n        .section-container:nth-child(8) h4 i.fa { --animation-order: 8; }\\n\\n        /* 移动端适配 */\\n        @media (max-width: 600px) {\\n            body {\\n                padding: 15px 10px; /* 减少页面边距 */\\n            }\\n            .status-block {\\n                padding: 15px; /* 减少主块内边距 */\\n                max-width: 100%; /* 允许在小屏上更宽 */\\n            }\\n            .section-container {\\n                 padding: 10px 15px; /* 减少模块内边距 */\\n                 margin-bottom: 15px;\\n            }\\n            .section-content {\\n                padding-left: 5px; /* 减少内容缩进 */\\n                 font-size: 0.95em; /* 略微减小内容字体 */\\n            }\\n            .section-container h4 {\\n                font-size: 1em; /* 略微减小标题字体 */\\n                margin-bottom: 10px;\\n            }\\n            .section-container h4 i.fa {\\n                 margin-right: 8px;\\n            }\\n        }\\n\\n    </style>\\n</head>\\n<body>\\n\\n<!-- status-block 现在默认展开，没有折叠按钮和相关 JS -->\\n<div class=\\\"status-block\\\">\\n    <div class=\\\"status-content-wrapper\\\">\\n        <!-- ... (所有 .section-container 内容不变) ... -->\\n        <div class=\\\"section-container\\\">\\n            <h4><i class=\\\"fa fa-scroll fa-fw\\\"></i> 基本信息</h4>\\n            <div class=\\\"section-content\\\">$1</div>\\n        </div>\\n        <div class=\\\"section-container\\\">\\n            <h4><i class=\\\"fa fa-calendar-day fa-fw\\\"></i> 今日次数</h4>\\n            <div class=\\\"section-content\\\">$2</div>\\n        </div>\\n        <div class=\\\"section-cont