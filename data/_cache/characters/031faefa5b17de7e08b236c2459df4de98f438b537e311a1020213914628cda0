                     \\n                        // 创建命令列表\\n                        const commands = [];\\n                        \\n                        // 添加保存到世界书的命令\\n                        commands.push(`/setentryfield file=AV工作室 uid=10 field=content ${jsonString}`);\\n                        commands.push(`/setentryfield file=AV工作室 uid=10 field=constant 1`);\\n                        commands.push(`/setentryfield file=AV工作室 uid=10 field=position 4`);\\n                        commands.push(`/setentryfield file=AV工作室 uid=10 field=role 0`);\\n                        \\n                        // 不再添加发送消息的命令\\n                        \\n                        // 发送triggerSlash消息，包含保存世界书的命令\\n                        if (typeof triggerSlash === 'function') {\\n                            const commandString = commands.join('|');\\n                            AppState.log(\\\"发送的命令长度:\\\", commandString.length);\\n                            triggerSlash(commandString);\\n                            // 显示成功消息\\n                            AppState.showSuccess(`角色${characterName}已保存到世界书`);\\n                        } else {\\n                            console.error('triggerSlash 函数不可用');\\n                            AppState.showError('保存失败：triggerSlash 函数不可用');\\n                        }\\n                    } catch (error) {\\n                        AppState.error('处理角色数据出错:', error);\\n                        AppState.showError('保存失败：处理角色数据时出错');\\n                    }\\n                }, 500);\\n            } catch (error) {\\n                console.error('保存角色出错:', error);\\n                AppState.setLoading(false);\\n                AppState.showError('保存角色时发生错误');\\n            }\\n        }\\n    </script>\\n</body>\\n</html>\\n```\",\"trimStrings\":[],\"placement\":[2],\"disabled\":false,\"markdownOnly\":true,\"promptOnly\":false,\"runOnEdit\":true,\"substituteRegex\":0,\"minDepth\":null,\"maxDepth\":2},{\"id\":\"bf79fe72-c36f-4890-98f5-3f32