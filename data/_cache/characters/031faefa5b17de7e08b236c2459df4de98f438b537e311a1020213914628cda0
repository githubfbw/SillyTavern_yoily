             </li>\\n                </ul>\\n                \\n                <!-- 总报酬容器 -->\\n                <div class=\\\"total-fee-container\\\" id=\\\"total-fee-container\\\">\\n                    <div class=\\\"total-fee\\\">\\n                        <i class=\\\"fas fa-coins\\\"></i> 总报酬: <span id=\\\"total-fee-value\\\">0</span> 円\\n                    </div>\\n                </div>\\n                \\n                <!-- 输入框和发送按钮 -->\\n                <div class=\\\"input-container\\\">\\n                    <input type=\\\"text\\\" class=\\\"dialogue-input\\\" id=\\\"dialogue-input\\\" placeholder=\\\"此处输入对话和行动内容...\\\">\\n                    <button class=\\\"send-button\\\" id=\\\"send-button\\\">\\n                        <i class=\\\"fas fa-paper-plane\\\"></i> 发送\\n                    </button>\\n                </div>\\n                \\n                <!-- 按钮区域 -->\\n                <div class=\\\"action-buttons\\\">\\n                    <button class=\\\"action-button confirm-button\\\" id=\\\"confirm-button\\\">\\n                        <i class=\\\"fas fa-check\\\"></i> 确认流程\\n                    </button>\\n                    <button class=\\\"action-button modify-button\\\" id=\\\"modify-button\\\">\\n                        <i class=\\\"fas fa-edit\\\"></i> 修改流程\\n                    </button>\\n                    <button class=\\\"action-button cancel-button\\\" id=\\\"cancel-button\\\">\\n                        <i class=\\\"fas fa-times\\\"></i> 取消拍摄\\n                    </button>\\n                    <button class=\\\"action-button modify-button\\\" id=\\\"simplify-button\\\">\\n                        <i class=\\\"fas fa-compress-alt\\\"></i> 简化流程\\n                    </button>\\n                </div>\\n            </div>\\n        </div>\\n    </div>\\n    \\n    <!-- 加载动画 -->\\n    <div class=\\\"loading-overlay\\\" id=\\\"loading-overlay\\\">\\n        <div class=\\\"loading-spinner\\\"></div>\\n    </div>\\n    \\n    <!-- 修改流程弹窗 -->\\n    <div class=\\\"modal-overlay\\\" id=\\\"modify-modal\\\">\\n        <div class=\\\"modal-container\\\">\\n            <div class=\\\"modal-header\\\">\\n                <h3><i class=\\\"fas fa-edit\\\"></i> 修改拍摄流程</h3>\\n                <button class=\\\"close-button\\\" id=\\\"close-modal-button\\\">\\n                    <i class=\\\"fas fa-times\\\"></i>\\n                </button>\\n            </div>\\n            <div class=\\\"modal-content\\\">\\n                <p class=\\\"modal-description\\\">请输入您对拍摄流程的修改要求：</p>\\n                <textarea id=\\\"modify-input\\\" placeholder=\\\"例如：增加一个室外场景拍摄环节...\\\" rows=\\\"5\\\"></textarea>\\n            </div>\\n            <div class=\\\"modal-actions\\\">\\n                <button class=\\\"action-button cancel-button\\\" id=\\\"modal-cancel-button\\\">\\n                    <i class=\\\"fas fa-times\\\"></i> 取消\\n                </button>\\n                <button class=\\\"action-button confirm-button\\\" id=\\\"modal-confirm-button\\\">\\n                    <i class=\\\"fas fa-check\\\"></i> 确认修改\\n                </button>\\n            </div>\\n        </div>\\n    </div>\\n\\n    <script>\\n        // 全局状态管理\\n        const AppState = {\\n            isLoading: false,\\n            characterName: '',\\n            filmGenre: '',\\n            narrativeText: '',\\n            processList: [],\\n            \\n            // 设置加载状态\\n            setLoading(loading) {\\n                this.isLoading = loading;\\n                const overlay = document.getElementById('loading-overlay');\\n                if (loading) {\\n                    overlay.classList.add('active');\\n                } else {\\n                    overlay.classList.remove('active');\\n                }\\n            },\\n            \\n            // 显示错误消息\\n            showError(message) {\\n                const errorContainer = document.getElementById('error-container');\\n                const errorMessage = document.getElementById('error-message');\\n                \\n                errorMessage.textContent = message;\\n                errorContainer.classList.add('show');\\n                \\n                // 5秒后自动隐藏\\n                setTimeout(() => {\\n                    errorContainer.classList.remove('show');\\n                }, 5000);\\n            },\\n            \\n            // 显示成功消息\\n            showSuccess(message) {\\n                // 如果存在错误容器，则复用它\\n                const errorContainer = document.getElementById('error-container');\\n                const errorMessage = document.getElementById('error-message');\\n                \\n                if (errorContainer && errorMessage) {\\n                    // 修改样式为成功状态\\n                    errorContainer.style.backgroundColor = 'rgba(3, 218, 198, 0.2)';\\n                    errorMessage.style.color = '#03dac6';\\n                    \\n                    // 更新消息内容\\n                    errorMessage.textContent = message;\\n                    errorContainer.classList.add('show');\\n                    \\n                    // 3秒后自动隐藏\\n                    setTimeout(() => {\\n                        errorContainer.classList.remove('show');\\n                        // 恢复原始样式\\n                        errorContainer.style.backgroundColor = '';\\n                        errorMessage.style.color = '';\\n                    }, 3000);\\n                }\\n            }\\n        };\\n        \\n        // 数据提取模块\\n        const DataExtractor = {\\n            // 解析整个流程数据\\n            parseProcessData(text) {\\n                try {\\n                    // 正则匹配整个process标签内容\\n                    const processMatch = text.match(/<process>([\\\\s\\\\S]*?)<\\\\/process>/);\\n                    if (!processMatch) return null;\\n                    \\n                    const processContent = processMatch[1].trim();\\n                    \\n                    // 提取角色姓名 - 使用正则匹配而不依赖于换行\\n                    const nameMatch = processContent.match(/\\\\[角色姓名\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const characterName = nameMatch ? nameMatch[1] : '未知角色';\\n                    \\n                    // 提取影片题材 - 使用正则匹配而不依赖于换行\\n                    const genreMatch = processContent.match(/\\\\[影片题材\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const filmGenre = genreMatch ? genreMatch[1] : '未设定';\\n                    \\n                    // 提取正文内容 - 使用[\\\\s\\\\S]*?匹配可能包含换行符的内容\\n                    const narrativeMatch = processContent.match(/\\\\[正文\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const narrativeText = narrativeMatch ? narrativeMatch[1] : '无正文内容';\\n                    \\n                    // 提取所有拍摄流程项目 - 使用全局正则匹配所有符合模式的内容\\n                    const processItems = [];\\n                    const processRegex = /\\\\[拍摄流程\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\]/g;\\n                    let match;\\n                    \\n                    while ((match = processRegex.exec(processContent)) !== null) {\\n                        // 格式：分别保存项目名称、项目简介和项目报酬\\n                        processItems.push({\\n                            title: match[1], \\n                            description: match[2],\\n                            fee: match[3] || \\\"0\\\" // 添加报酬字段，如果没有则默认为0\\n                        });\\n                    }\\n                    \\n                    return {\\n                        characterName,\\n                        filmGenre,\\n                        narrativeText,\\n                        processItems\\n                    };\\n                } catch (error) {\\n                    console.error('解析数据出错:', error);\\n                    return null;\\n                }\\n            }\\n        };\\n        \\n        // 数据渲染模块\\n        const UI = {\\n            // 渲染角色姓名\\n            renderCharacterName(name) {\\n                document.getElementById('character-name').textContent = name;\\n            },\\n            \\n            // 渲染影片题材\\n            renderFilmGenre(genre) {\\n                document.getElementById('film-genre').textContent = genre;\\n            },\\n            \\n            // 渲染正文内容\\n            renderNarrativeText(text) {\\n                const narrativeContent = document.getElementById('narrative-content');\\n                \\n                // 清空现有内容\\n                narrativeContent.innerHTML = '';\\n                \\n                // 分段处理文本\\n                if (text) {\\n                    // 分割文本为段落 - 使用两个或多个连续换行符作为段落分隔符\\n                    // 或使用明确的[p]标记作为段落分隔符\\n                    const paragraphs = text.split(/\\\\n\\\\n+|\\\\[p\\\\]/g);\\n                    \\n                    // 为每个段落创建一个p元素\\n                    paragraphs.forEach(paragraph => {\\n                        // 跳过空段落\\n                        if (!paragraph.trim()) return;\\n                        \\n                        // 处理单个换行符为<br>\\n                        const formattedParagraph = paragraph.trim().replace(/\\\\n/g, '<br>');\\n                        \\n                        // 创建段落元素\\n                        const p = document.createElement('p');\\n                        p.innerHTML = formattedParagraph;\\n                        \\n                        // 添加到容器\\n                        narrativeContent.appendChild(p);\\n                    });\\n                } else {\\n                    narrativeContent.textContent = '无正文内容';\\n                }\\n            },\\n            \\n            // 渲染拍摄流程列表\\n            renderProcessList(items) {\\n                const processList = document.getElementById('process-list');\\n                processList.innerHTML = '';\\n                \\n                if (!items || items.length === 0) {\\n                    const emptyItem = document.createElement('li');\\n                    emptyItem.className = 'process-item';\\n                    emptyItem.innerHTML = `\\n                        <span class=\\\"process-title\\\">暂无拍摄流程</span>\\n                        <p class=\\\"process-description\\\">还没有设定拍摄流程项目</p>\\n                    `;\\n                    processList.appendChild(emptyItem);\\n                    return;\\n                }\\n                \\n                // 计算总报酬\\n                let totalFee = 0;\\n                \\n                items.forEach((item, index) => {\\n                    const listItem = document.createElement('li');\\n                    listItem.className = 'process-item';\\n                    if (index === 0) listItem.classList.add('active');\\n                    \\n                    // 处理报酬\\n                    const fee = item.fee ? parseFloat(item.fee.replace(/[^\\\\d.]/g, '')) : 0;\\n                    totalFee += fee;\\n                    \\n                    // 格式化报酬显示\\n                    const feeDisplay = fee > 0 ? `<div class=\\\"process-fee\\\">${fee} 円</div>` : '';\\n                    \\n                    // 使用新格式，包含报酬显示\\n                    listItem.innerHTML = `\\n                        <span class=\\\"process-title\\\">${item.title}</span>\\n                        <p class=\\\"process-description\\\">${item.description}</p>\\n                        ${feeDisplay}\\n                    `;\\n                    \\n                    // 添加点击事件\\n                    listItem.addEventListener('click', () => {\\n                        document.querySelectorAll('.process-item').forEach(item => {\\n                            item.classList.remove('active');\\n                        });\\n                        listItem.classList.add('active');\\n                    });\\n                    \\n                    processList.appendChild(listItem);\\n                });\\n                \\n                // 更新总报酬显示\\n                document.getElementById('total-fee-value').textContent = totalFee.toLocaleString();\\n            },\\n            \\n            // 渲染所有数据\\n            renderAllData(data) {\\n                if (!data) {\\n                    AppState.showError('无法解析数据');\\n                    return;\\n                }\\n                \\n                this.renderCharacterName(data.characterName);\\n                this.renderFilmGenre(data.filmGenre);\\n                this.renderNarrativeText(data.narrativeText);\\n                this.renderProcessList(data.processItems);\\n                \\n                // 保存到应用状态\\n                AppState.characterName = data.characterName;\\n                AppState.filmGenre = data.filmGenre;\\n                AppState.narrativeText = data.narrativeText;\\n                AppState.processList = data.processItems;\\n            }\\n        };\\n        \\n        // 初始化按钮事件\\n        function setupButtons() {\\n            // 确认按钮\\n            document.getElementById('confirm-button').addEventListener('click', () => {\\n                if (AppState.isLoading) return;\\n                \\n                AppState.setLoading(true);\\n                setTimeout(() => {\\n                    AppState.setLoading(false);\\n                    \\n                    // 获取第一条流程信息\\n                    const firstProcess = AppState.processList && AppState.processList.length > 0 \\n                        ? AppState.processList[0] \\n                        : { title: '未知流程', description: '无描述' };\\n                    \\n                    // 向主应用发送确认消息，包含第一条流程信息\\n                    if (typeof triggerSlash === 'function') {\\n                        triggerSlash(`/send 【拍摄界面】已确认${AppState.characterName}的拍摄流程，开始第一部分拍摄：${firstProcess.title}，${firstProcess.description}|/trigger`);\\n                    } else {\\n                        console.log(`已确认${AppState.characterName}的拍摄流程，开始第一部分拍摄：${firstProcess.title}，${firstProcess.description}`);\\n                    }\\n                }, 800);\\n            });\\n            \\n            // 修改按钮 - 显示修改弹窗\\n            document.getElementById('modify-button').addEventListener('click', () => {\\n                if (AppState.isLoading) return;\\n                \\n                // 显示修改弹窗\\n                showModifyModal();\\n            });\\n            \\n            // 取消按钮\\n            document.getElementById('cancel-button').addEventListener('click', () => {\\n                if (AppState.isLoading) return;\\n                \\n                // 向主应用发送取消请求\\n                if (typeof triggerSlash === 'function') {\\n                    triggerSlash(`/send 【主界面】取消与${AppState.characterName}的拍摄,重新开始选择角色|/trigger`);\\n                } else {\\n                    console.log(`取消与${AppState.characterName}的拍摄`);\\n                }\\n            });\\n            \\n            // 简化流程按钮\\n            document.getElementById('simplify-button').addEventListener('click', () => {\\n                if (AppState.isLoading) return;\\n                \\n                // 计算简化后的流程数量（总数/2，向上取整）\\n                const totalProcesses = AppState.processList ? AppState.processList.length : 0;\\n                const simplifiedCount = Math.ceil(totalProcesses / 2);\\n                \\n                AppState.setLoading(true);\\n                setTimeout(() => {\\n                    AppState.setLoading(false);\\n                    \\n                    // 向主应用发送简化流程请求\\n                    if (typeof triggerSlash === 'function') {\\n                        triggerSlash(`/send 【拍摄流程界面】{{User}}决定精简流程，合并非重要拍摄项目，保留重要拍摄项目，最终精简到${simplifiedCount}个拍摄流程|/trigger`);\\n                    } else {\\n                        console.log(`简化${AppState.characterName}的拍摄流程到${simplifiedCount}个项目`);\\n                    }\\n                }, 800);\\n            });\\n            \\n            // 弹窗关闭按钮\\n            document.getElementById('close-modal-button').addEventListener('click', hideModifyModal);\\n            \\n            // 弹窗取消按钮\\n            document.getElementById('modal-cancel-button').addEventListener('click', hideModifyModal);\\n            \\n            // 弹窗确认修改按钮\\n            document.getElementById('modal-confirm-button').addEventListener('click', submitModification);\\n            \\n            // 当点击模态框外部时关闭模态框\\n            document.getElementById('modify-modal').addEventListener('click', function(event) {\\n                if (event.target === this) {\\n                    hideModifyModal();\\n                }\\n            });\\n            \\n            // 键盘ESC键关闭弹窗\\n            document.addEventListener('keydown', function(event) {\\n                if (event.key === 'Escape') {\\n                    hideModifyModal();\\n                }\\n            });\\n        }\\n        \\n        // 显示修改弹窗\\n        function showModifyModal() {\\n            const modal = document.getElementById('modify-modal');\\n            modal.classList.add('active');\\n            \\n            // 设置焦点到输入框\\n            setTimeout(() => {\\n                document.getElementById('modify-input').focus();\\n            }, 300);\\n        }\\n        \\n        // 隐藏修改弹窗\\n        function hideModifyModal() {\\n            const modal = document.getElementById('modify-modal');\\n            modal.classList.remove('active');\\n            \\n            // 清空输入框\\n            document.getElementById('modify-input').value = '';\\n        }\\n        \\n        // 提交修改请求\\n        function submitModification() {\\n            const modifyInput = document.getElementById('modify-input');\\n            const modificationText = modifyInput.value.trim();\\n            \\n            if (!modificationText) {\\n                AppState.showError('请输入修改要求内容');\\n                return;\\n            }\\n            \\n            // 隐藏弹窗\\n            hideModifyModal();\\n            \\n            // 向主应用发送修改请求（包含用户输入的修改内容）\\n            if (typeof triggerSlash === 'function') {\\n              