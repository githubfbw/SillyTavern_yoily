ctedCard.querySelector('h3').textContent;\\n                AppState.log(`正在保存角色: ${characterName}, 索引: ${index}`);\\n                \\n                // 显示加载中\\n                AppState.setLoading(true);\\n                \\n                // 模拟异步操作\\n                setTimeout(() => {\\n                    try {\\n                        // 隐藏加载中\\n                        AppState.setLoading(false);\\n                        \\n                        // 调整DOM元素ID的索引 - 注意这里UI索引从1开始\\n                        const uiIndex = index + 1;\\n                        AppState.log(`使用UI索引: ${uiIndex} 获取DOM元素`);\\n                        \\n                        // 直接从界面获取字段值，确保数据正确\\n                        const entryContent = {\\n                            name: document.getElementById(`char${uiIndex}-name`)?.textContent || \\\"未知\\\",\\n                            age: document.getElementById(`char${uiIndex}-age`)?.textContent || \\\"未知\\\",\\n                            personality: document.getElementById(`char${uiIndex}-personality`)?.textContent || \\\"未知\\\",\\n                            background: document.getElementById(`char${uiIndex}-background`)?.textContent || \\\"未知\\\",\\n                            // 外观信息\\n                            height: document.getElementById(`char${uiIndex}-height`)?.textContent || \\\"未知\\\",\\n                            weight: document.getElementById(`char${uiIndex}-weight`)?.textContent || \\\"未知\\\",\\n                            cup: document.getElementById(`char${uiIndex}-cup`)?.textContent || \\\"未知\\\",\\n                            hairColor: document.getElementById(`char${uiIndex}-hair`)?.textContent || \\\"未知\\\",\\n                            hairStyle: document.getElementById(`char${uiIndex}-hairstyle`)?.textContent || \\\"未知\\\",\\n                            clothes: document.getElementById(`char${uiIndex}-clothes`)?.textContent || \\\"未知\\\",\\n                            shoes: document.getElementById(`c