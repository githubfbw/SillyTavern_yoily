-bottom: 15px;\\n        }\\n        \\n        .input-group {\\n            flex: 1;\\n        }\\n        \\n        .input-group.full-width {\\n            width: 100%;\\n        }\\n        \\n        .input-group label {\\n            display: block;\\n            color: var(--text-secondary);\\n            margin-bottom: 8px;\\n            font-size: 0.9rem;\\n        }\\n        \\n        .custom-input {\\n            width: 100%;\\n            padding: 12px 15px;\\n            background-color: rgba(18, 18, 31, 0.7);\\n            border: 1px solid rgba(187, 134, 252, 0.2);\\n            border-radius: 8px;\\n            color: var(--text-primary);\\n            font-family: 'Roboto', sans-serif;\\n            font-size: 0.95rem;\\n            transition: all 0.3s ease;\\n        }\\n        \\n        .custom-input:focus {\\n            outline: none;\\n            border-color: var(--primary-color);\\n            box-shadow: 0 0 10px rgba(187, 134, 252, 0.3);\\n        }\\n        \\n        .custom-input::placeholder {\\n            color: rgba(255, 255, 255, 0.3);\\n        }\\n        \\n        textarea.custom-input {\\n            resize: vertical;\\n            min-height: 80px;\\n        }\\n        \\n        .generate-button {\\n            background: linear-gradient(45deg, var(--info-color), var(--info-variant));\\n            color: var(--dark-bg);\\n            margin-top: 10px;\\n            margin-left: auto;\\n            margin-right: auto;\\n            max-width: 250px;\\n            display: block;\\n        }\\n        \\n        .generate-button:hover {\\n            box-shadow: 0 0 15px rgba(255, 171, 64, 0.7);\\n            transform: translateY(-2px);\\n        }\\n        \\n        @media (max-width: 768px) {\\n            .input-row {\\n                flex-direction: column;\\n                gap: 15px;\\n            }\\n            \\n            .input-group {\\n                width: 100%;\\n            }\\n            \\n            .generate-button {\\n                width: 100%;\\n                max-width: 100%;\\n            }\\n        }\\n    </style>\\n</head>\\n<body>\\n    <div class=\\\"container\\\">\\n        <!-- 头部信息 -->\\n        <div class=\\\"header\\\">\\n            <div class=\\\"character-info\\\">\\n                <span class=\\\"character-label\\\">角色名称</span>\\n                <span class=\\\"character-name\\\" id=\\\"character-name\\\">未加载</span>\\n            </div>\\n            <div class=\\\"date-info\\\">\\n                <span class=\\\"date-label\\\">日期信息</span>\\n                <span class=\\\"date-value\\\" id=\\\"date-value\\\">未知日期</span>\\n            </div>\\n            <div class=\\\"status-info\\\">\\n                <span class=\\\"status-label\\\">当前状态</span>\\n                <span class=\\\"status-value\\\">日后谈</span>\\n            </div>\\n        </div>\\n        \\n        <!-- 错误消息显示区域 -->\\n        <div class=\\\"error-message\\\" id=\\\"error-container\\\">\\n            <i class=\\\"fas fa-exclamation-triangle\\\"></i> <span id=\\\"error-message\\\">错误信息将显示在这里</span>\\n        </div>\\n        \\n        <!-- 主要内容区域 -->\\n        <div class=\\\"content-container\\\">\\n            <!-- 第一行：地点和角色信息 -->\\n            <div class=\\\"info-row\\\">\\n                <!-- 地点卡片 -->\\n                <div class=\\\"card location-card\\\">\\n                    <h2>\\n                        <i class=\\\"fas fa-map-marker-alt\\\"></i> 当前地点\\n                    </h2>\\n                    <div class=\\\"location-content\\\">\\n                        <div class=\\\"detail-item\\\">\\n                            <div class=\\\"location-name\\\" id=\\\"location-name\\\">加载中...</div>\\n                        </div>\\n                        <div class=\\\"detail-item\\\">\\n                            <div class=\\\"location-description\\\" id=\\\"location-description\\\">正在获取地点信息...</div>\\n                        </div>\\n                    </div>\\n                </div>\\n                \\n                <!-- 角色细节卡片 -->\\n                <div class=\\\"card character-detail-card\\\">\\n                    <h2>\\n                        <i class=\\\"fas fa-user-circle\\\"></i> 角色外观\\n                    </h2>\\n                    <div class=\\\"detail-content\\\">\\n                        <div class=\\\"detail-item\\\">\\n                            <div class=\\\"detail-label\\\">衣着：</div>\\n                            <div class=\\\"detail-value\\\" id=\\\"character-outfit\\\">加载中...</div>\\n                        </div>\\n                        <div class=\\\"detail-item\\\">\\n                            <div class=\\\"detail-label\\\">鞋袜：</div>\\n                            <div class=\\\"detail-value\\\" id=\\\"character-footwear\\\">加载中...</div>\\n                        </div>\\n                        <div class=\\\"detail-item\\\">\\n                            <div class=\\\"detail-label\\\">配饰：</div>\\n                            <div class=\\\"detail-value\\\" id=\\\"character-accessories\\\">加载中...</div>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n            \\n            <!-- 第二行：人物关系 -->\\n            <div class=\\\"card relationships-card\\\">\\n                <h2>\\n                    <i class=\\\"fas fa-users\\\"></i> 相关人物\\n                </h2>\\n                <ul class=\\\"relationships-list\\\" id=\\\"relationships-list\\\">\\n                    <!-- 人物关系项将通过JS动态添加 -->\\n                    <li class=\\\"relationship-item\\\">\\n                        <div class=\\\"relationship-avatar\\\">?</div>\\n                        <div class=\\\"relationship-info\\\">\\n                            <div class=\\\"relationship-name\\\">加载中...</div>\\n                            <div class=\\\"relationship-type\\\">未知关系</div>\\n                        </div>\\n                    </li>\\n                </ul>\\n            </div>\\n            \\n            <!-- 生活剧情 -->\\n            <div class=\\\"card story-card\\\">\\n                <h2>\\n                    <i class=\\\"fas fa-book-open\\\"></i> 生活剧情\\n                </h2>\\n                <div class=\\\"story-content\\\" id=\\\"story-content\\\">\\n                    <p>正在加载剧情内容...</p>\\n                </div>\\n            </div>\\n            \\n            <!-- 角色想法 -->\\n            <div class=\\\"card thoughts-card\\\">\\n                <h2>\\n                    <i class=\\\"fas fa-brain\\\"></i> 角色想法\\n                </h2>\\n                <div class=\\\"thoughts-content\\\" id=\\\"character-thoughts\\\">\\n                    正在加载角色想法...\\n                </div>\\n            </div>\\n        </div>\\n        \\n        <!-- 剧情生成输入区域 -->\\n        <div class=\\\"generation-container\\\">\\n            <h3 class=\\\"generation-title\\\"><i class=\\\"fas fa-magic\\\"></i> 自定义剧情生成</h3>\\n            <div class=\\\"input-row\\\">\\n                <div class=\\\"input-group\\\">\\n                    <label for=\\\"time-input\\\">时间 (选填)</label>\\n                    <input type=\\\"text\\\" id=\\\"time-input\\\" class=\\\"custom-input\\\" placeholder=\\\"例如：一年后\\\">\\n                </div>\\n                <div class=\\\"input-group\\\">\\n                    <label for=\\\"location-input\\\">地点 (选填)</label>\\n                    <input type=\\\"text\\\" id=\\\"location-input\\\" class=\\\"custom-input\\\" placeholder=\\\"例如：海边度假屋\\\">\\n                </div>\\n            </div>\\n            <div class=\\\"input-row\\\">\\n                <div class=\\\"input-group full-width\\\">\\n                    <label for=\\\"story-input\\\">想看到的剧情</label>\\n                    <textarea id=\\\"story-input\\\" class=\\\"custom-input\\\" placeholder=\\\"请输入您希望看到的剧情内容...\\\" rows=\\\"3\\\"></textarea>\\n                </div>\\n            </div>\\n            <button class=\\\"action-button generate-button\\\" id=\\\"generate-btn\\\">\\n                <i class=\\\"fas fa-wand-magic-sparkles\\\"></i> 生成剧情\\n            </button>\\n        </div>\\n        \\n        <!-- 底部按钮区域 -->\\n        <div class=\\\"action-buttons\\\">\\n            <button class=\\\"action-button primary-button\\\" id=\\\"next-btn\\\">\\n                <i class=\\\"fas fa-play\\\"></i> 继续剧情\\n            </button>\\n            <button class=\\\"action-button invite-button\\\" id=\\\"invite-btn\\\">\\n                <i class=\\\"fas fa-video\\\"></i> 再次邀请\\n            </button>\\n            <button class=\\\"action-button secondary-button\\\" id=\\\"back-btn\\\">\\n                <i class=\\\"fas fa-home\\\"></i> 返回主界面\\n            </button>\\n        </div>\\n    </div>\\n    \\n    <!-- 加载动画 -->\\n    <div class=\\\"loading-overlay\\\" id=\\\"loading-overlay\\\">\\n        <div class=\\\"loading-spinner\\\"></div>\\n    </div>\\n\\n    <script>\\n        // 全局状态管理\\n        const AppState = {\\n            isLoading: false,\\n            characterName: '',\\n            date: '',\\n            dateAfter: '',\\n            location: '',\\n            locationDescription: '',\\n            outfit: '',\\n            footwear: '',\\n            accessories: '',\\n            relatedCharacters: [], // [{name, relationship}]\\n            thoughts: '',\\n            story: '',\\n            \\n            // 设置加载状态\\n            setLoading(loading) {\\n                this.isLoading = loading;\\n                const overlay = document.getElementById('loading-overlay');\\n                if (loading) {\\n                    overlay.classList.add('active');\\n                } else {\\n                    overlay.classList.remove('active');\\n                }\\n            },\\n            \\n            // 显示错误消息\\n            showError(message) {\\n                console.error('错误:', message);\\n                // 使用自定义错误UI\\n                const errorContainer = document.getElementById('error-container');\\n                const errorMessage = document.getElementById('error-message');\\n                \\n                if (errorContainer && errorMessage) {\\n                    errorMessage.textContent = message;\\n                    errorContainer.classList.add('show');\\n                    \\n                    // 5秒后自动隐藏\\n                    setTimeout(() => {\\n                        errorContainer.classList.remove('show');\\n                    }, 5000);\\n                }\\n            },\\n            \\n            // 显示成功消息\\n            showSuccess(message) {\\n                console.log('成功:', message);\\n                // 使用自定义错误UI元素但显示成功样式\\n                const errorContainer = document.getElementById('error-container');\\n                const errorMessage = document.getElementById('error-message');\\n                \\n                if (errorContainer && errorMessage) {\\n                    // 修改样式为成功状态\\n                    errorContainer.style.backgroundColor = 'rgba(3, 218, 198, 0.2)';\\n                    errorMessage.style.color = '#03dac6';\\n                    \\n                    // 更新消息内容\\n                    errorMessage.textContent = message;\\n                    errorContainer.classList.add('show');\\n                    \\n                    // 3秒后自动隐藏\\n                    setTimeout(() => {\\n                        errorContainer.classList.remove('show');\\n                        // 恢复原始样式\\n                        errorContainer.style.backgroundColor = '';\\n                        errorMessage.style.color = '';\\n                    }, 3000);\\n                }\\n            }\\n        };\\n        \\n        // 数据提取模块\\n        const DataExtractor = {\\n            // 解析日后谈数据\\n            parseAfterShootData(text) {\\n                try {\\n                    // 正则匹配整个after_shoot标签内容\\n                    const afterShootMatch = text.match(/<after_shoot>([\\\\s\\\\S]*?)<\\\\/after_shoot>/);\\n                    if (!afterShootMatch) return null;\\n                    \\n                    const afterShootContent = afterShootMatch[1].trim();\\n                    \\n                    // 提取角色姓名\\n                    const nameMatch = afterShootContent.match(/\\\\[角色姓名\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const characterName = nameMatch ? nameMatch[1] : '未知角色';\\n                    \\n                    // 提取日期信息\\n                    const dateMatch = afterShootContent.match(/\\\\[日期\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const date = dateMatch ? dateMatch[1] : '未知日期';\\n                    const dateAfter = dateMatch ? dateMatch[2] : '';\\n                    \\n                    // 提取地点信息\\n                    const locationMatch = afterShootContent.match(/\\\\[地点\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const location = locationMatch ? locationMatch[1] : '未知地点';\\n                    const locationDescription = locationMatch ? locationMatch[2] : '';\\n                    \\n                    // 提取当前场景其他人物\\n                    const charactersMatch = afterShootContent.match(/\\\\[当前场景其他人物\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const relatedCharacters = [];\\n                    \\n                    if (charactersMatch) {\\n                        const charactersContent = charactersMatch[1];\\n                        // 分割角色信息\\n                        const characters = charactersContent.split('|');\\n                        \\n                        // 每两个为一组: 姓名和关系\\n                        for (let i = 0; i < characters.length - 1; i += 2) {\\n                            relatedCharacters.push({\\n                                name: characters[i],\\n                                relationship: characters[i + 1]\\n                            });\\n                        }\\n                    }\\n                    \\n                    // 提取角色衣着\\n                    const outfitMatch = afterShootContent.match(/\\\\[角色衣着\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const outfit = outfitMatch ? outfitMatch[1] : '未描述';\\n                    const footwear = outfitMatch ? outfitMatch[2] : '未描述';\\n                    const accessories = outfitMatch ? outfitMatch[3] : '未描述';\\n                    \\n                    // 提取角色想法\\n                    const thoughtsMatch = afterShootContent.match(/\\\\[角色想法\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const thoughts = thoughtsMatch ? thoughtsMatch[1] : '未描述';\\n                    \\n                    // 提取正文\\n                    const storyMatch = afterShootContent.match(/\\\\[正文\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const story = storyMatch ? storyMatch[1] : '暂无内容';\\n                    \\n                    return {\\n                        characterName,\\n                        date,\\n                        dateAfter,\\n                        location,\\n                        locationDescription,\\n                        relatedCharacters,\\n                        outfit,\\n                        footwear,\\n                        accessories,\\n                        thoughts,\\n                        story\\n                    };\\n                } catch (error) {\\n                    console.error('解析日后谈数据出错:', error);\\n                    return null;\\n                }\\n            }\\n        };\\n        \\n        // 数据渲染模块\\n        const UI = {\\n            // 渲染角色姓名\\n            renderCharacterName(name) {\\n                document.getElementById('character-name').textContent = name;\\n            },\\n            \\n            // 渲染日期信息\\n            renderDate(date, dateAfter) {\\n                let displayDate = date;\\n                if (dateAfter) {\\n                    displayDate += ` (${dateAfter})`;\\n                }\\n                document.getElementById('date-value').textContent = displayDate;\\n            },\\n            \\n            // 渲染地点信息\\n            renderLocation(location, description) {\\n                document.getElementById('location-name').textContent = location || '未知地点';\\n                document.getElementById('location-description').textContent = description || '无描述';\\n            },\\n            \\n            // 渲染角色外观\\n            renderAppearance(outfit, footwear, accessories) {\\n                document.getElementById('character-outfit').textContent = outfit || '未描述';\\n                document.getElementById('character-footwear').textContent = footwear || '未描述';\\n                document.getElementById('character-accessories').textContent = accessories || '未描述';\\n            },\\n            \\n            // 渲染人物关系\\n            renderRelationships(relationships) {\\n                const relationshipsList = document.getElementById('relationships-list');\\n                relationshipsList.innerHTML = '';\\n                \\n                if (!relationships || relationships.length === 0) {\\n                    const emptyItem = document.createElement('li');\\n                    emptyItem.className = 'relationship-item';\\n                    emptyItem.innerHTML = `\\n                        <div class=\\\"relationship-avatar\\\">?</div>\\n                        <div class=\\\"relationship-info\\\">\\n                            <div class=\\\"relationship-name\\\">暂无相关人物</div>\\n                            <div class=\\\"relationship-type\\\">-</div>\\n                        </div>\\n                    `;\\n                    relationshipsList.appendChild(emptyItem);\\n                    return;\\n                }\\n                \\n                relationships.forEach((character, index) => {\\n                    const item = document.createElement('li');\\n                    item.className = 'relationship-item';\\n                    \\n                    const avatar = document.createElement('div');\\n                    avatar.className = 'relationship-avatar';\\n                    avatar.textContent = character.name.charAt(0) || '?';\\n                    \\n                    const info = document.createElement('div');\\n                    info.className = 'relationship-info';\\n                    \\n                    const name = document.createElement('div');\\n                    name.className = 'relationship-name';\\n                    name.textContent = character.name;\\n                    \\n                    const relationship = document.createElement('div');\\n                    relationship.className = 'relationship-type';\\n                    relationship.textContent = character.relationship;\\n                    \\n                    info.appendChild(name);\\n                    info.appendChild(relationship);\\n                    \\n                    item.appendChild(avatar);\\n                    item.appendChild(info);\\n                    \\n                    relationshipsList.appendChild(item);\\n                });\\n            },\\n            \\n            // 渲染角色想法\\n            renderThoughts(thoughts) {\\n                document.getElementById('character-thoughts').textContent = thoughts || '角色没有表达任何想法';\\n            },\\n            \\n            // 渲染生活剧情\\n            renderStory(story) {\\n                const storyContent = document.getElementById('story-content');\\n                storyContent.innerHTML = '';\\n                \\n                if (!story) {\\n                    const p = document.createElement('p');\\n                    p.textContent = '暂无剧情内容';\\n                    storyContent.appendChild(p);\\n                    return;\\n                }\\n                \\n                // 使用与拍摄界面相似的方式处理文本\\n                storyContent.appendChild(this.formatText(story));\\n            },\\n            \\n            // 文本格式化函数，处理段落和换行\\n            formatText(text) {\\n                // 创建文档片段，用于存储格式化后的内容\\n                const fragment = document.createDocumentFragment();\\n                \\n                // 如果文本为空，返回默认文本\\n                if (!text) {\\n                    const defaultText = document.createElement('p');\\n                    defaultText.textContent = \\\"暂无内容\\\";\\n                    fragment.appendChild(defaultText);\\n                    return fragment;\\n                }\\n                \\n                // 分割文本为段落 - 使用两个或多个连续换行符作为段落分隔符\\n                // 或使用明确的[p]标记作为段落分隔符\\n                const paragraphs = text.split(/\\\\n\\\\n+|\\\\[p\\\\]/g);\\n                \\n                // 为每个段落创建一个p元素\\n                paragraphs.forEach(paragraph => {\\n                    // 跳过空段落\\n                    if (!paragraph.trim()) return;\\n                    \\n                    // 创建段落元素\\n                    const p = document.createElement('p');\\n                    \\n                    // 处理单个换行符\\n                    const parts = paragraph.trim().split('\\\\n');\\n                    \\n                    // 添加第一部分\\n                    if (parts.length > 0) {\\n                        p.appendChild(document.createTextNode(parts[0]));\\n                    }\\n                    \\n                    // 添加剩余部分，每部分之间插入<br>\\n                    for (let i = 1; i < parts.length; i++) {\\n                        p.appendChild(document.createElement('br'));\\n                        p.appendChild(document.createTextNode(parts[i]));\\n                    }\\n                    \\n                    // 添加到片段\\n                    fragment.appendChild(p);\\n                });\\n                \\n                return fragment;\\n            },\\n            \\n            // 渲染所有数据\\n            renderAllData(data) {\\n                if (!data) {\\n                    AppState.showError('无法解析数据');\\n                    return;\\n                }\\n                \\n                this.renderCharacterName(data.characterName);\\n                this.renderDate(data.date, data.dateAfter);\\n                this.renderLocation(data.location, data.locationDescription);\\n                this.renderAppearance(data.outfit, data.footwear, data.accessories);\\n                this.renderRelationships(data.relatedCharacters);\\n                this.renderThoughts(data.thoughts);\\n                this.renderStory(data.story);\\n                \\n                // 保存到应用状态\\n                Object.assign(AppState, data);\\n            }\\n        };\\n        \\n        // 设置按钮事件\\n        function setupButtons() {\\n            // 继续剧情按钮\\n            document.getElementById('next-btn').addEventListener('click', () => {\\n                if (AppState.isLoading) return;\\n                \\n                AppState.setLoading(true);\\n                setTimeout(() => {\\n                    AppState.setLoading(false);\\n                    \\n                    // 向主应用发送下一步互动的消息\\n                    if (typeof triggerSlash === 'function') {\\n                        triggerSlash(`/send 【日后谈界面】延续前文，继续${AppState.characterName}的剧情|/trigger`);\\n                    } else {\\n                        console.log(`继续${AppState.characterName}的剧情`);\\n                    }\\n                }, 800); // 添加延迟以显示加载效果\\n            });\\n            \\n            // 返回主界面按钮\\n            document.getElementById('back-btn').addEventListener('click', () => {\\n                if (AppState.isLoading) return;\\n                \\n                // 向主应用发送返回主界面的请求\\n                if (typeof triggerSlash === 'function') {\\n                    triggerSlash('/send 【主界面】结束日后谈,返回主界面,随机生成3个素人角色|/trigger');\\n                } else {\\n                    console.log('返回主界面');\\n                }\\n            });\\n            \\n            // 再次邀请按钮\\n            document.getElementById('invite-btn').addE