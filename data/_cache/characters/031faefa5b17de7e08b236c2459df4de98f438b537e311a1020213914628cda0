                   <div class=\\\"process-number\\\">1</div>\\n                            <div class=\\\"process-name\\\">加载中...</div>\\n                            <div class=\\\"process-status status-pending\\\">等待中</div>\\n                        </div>\\n                        <div class=\\\"process-description\\\">项目简介加载中...</div>\\n                    </li>\\n                </ul>\\n            </div>\\n        </div>\\n        \\n        <!-- 输入框和发送按钮 -->\\n        <div class=\\\"input-container\\\">\\n            <input type=\\\"text\\\" class=\\\"dialogue-input\\\" id=\\\"dialogue-input\\\" placeholder=\\\"此处输入对话和行动内容...\\\">\\n            <button class=\\\"send-button\\\" id=\\\"send-button\\\">\\n                <i class=\\\"fas fa-paper-plane\\\"></i> 发送\\n            </button>\\n        </div>\\n        \\n        <!-- 底部按钮区域 -->\\n        <div class=\\\"action-buttons\\\">\\n            <button class=\\\"action-btn reshoot-btn\\\" id=\\\"reshoot-btn\\\">\\n                <i class=\\\"fas fa-redo\\\"></i> 重拍\\n            </button>\\n            <button class=\\\"action-btn primary-btn\\\" id=\\\"next-btn\\\">\\n                下一步 <i class=\\\"fas fa-step-forward\\\"></i>\\n            </button>\\n            <button class=\\\"action-btn complete-btn\\\" id=\\\"complete-btn\\\">\\n                <i class=\\\"fas fa-check-circle\\\"></i> 完成拍摄\\n            </button>\\n        </div>\\n    </div>\\n    \\n    <!-- 快进确认弹窗 -->\\n    <div class=\\\"modal-overlay\\\" id=\\\"fast-forward-modal\\\">\\n        <div class=\\\"modal-container\\\">\\n            <div class=\\\"modal-title\\\">\\n                <i class=\\\"fas fa-fast-forward\\\"></i> 快进拍摄流程\\n            </div>\\n            <div class=\\\"modal-content\\\">\\n                快进可能导致无法完整体验角色拍摄流程中的身体和心理转变，是否进行跳转？\\n                <br><br>\\n                <span id=\\\"fast-forward-target\\\" style=\\\"color: var(--secondary-color); font-weight: 500;\\\"></span>\\n            </div>\\n            <div class=\\\"modal-actions\\\">\\n                <button class=\\\"modal-btn modal-confirm\\\" id=\\\"confirm-fast-forward\\\">\\n                    <i class=\\\"fas fa-check\\\"></i> 确定\\n                </button>\\n                <button class=\\\"modal-btn modal-cancel\\\" id=\\\"cancel-fast-forward\\\">\\n                    <i class=\\\"fas fa-times\\\"></i> 取消\\n                </button>\\n            </div>\\n        </div>\\n    </div>\\n    \\n    <script>\\n        // 页面加载完成后执行\\n        document.addEventListener('DOMContentLoaded', function() {\\n            // 切换视角选项卡\\n            const tabs = document.querySelectorAll('.tab');\\n            const thirdPersonContent = document.getElementById('third-person-content');\\n            const characterContent = document.getElementById('character-content');\\n            \\n            tabs.forEach(tab => {\\n                tab.addEventListener('click', function() {\\n                    // 移除所有选项卡的active类\\n                    tabs.forEach(t => t.classList.remove('active'));\\n                    // 为当前选项卡添加active类\\n                    this.classList.add('active');\\n                    \\n                    // 显示对应内容\\n                    if (this.dataset.tab === 'third-person') {\\n                        thirdPersonContent.style.display = 'block';\\n                        characterContent.style.display = 'none';\\n                    } else {\\n                        thirdPersonContent.style.display = 'none';\\n                        characterContent.style.display = 'block';\\n                    }\\n                });\\n            });\\n            \\n            // 解析拍摄数据\\n            function parseShootData(shootData) {\\n                // 提取<shoot>标签内容\\n                const shootMatch = shootData.match(/<shoot>([\\\\s\\\\S]*?)<\\\\/shoot>/);\\n                const shootContent = shootMatch ? shootMatch[1].trim() : shootData;\\n                \\n                // 解析角色信息\\n                const roleMatch = shootContent.match(/\\\\[角色\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                const characterName = roleMatch ? roleMatch[1] : \\\"未知角色\\\";\\n                const characterOutfit = roleMatch ? roleMatch[2] : \\\"无描述\\\";\\n                \\n                // 解析第三人称视角 - 使用[\\\\s\\\\S]*?替代.*?来匹配可能包含换行符的内容\\n                const thirdPersonMatch = shootContent.match(/\\\\[第三人称视角\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                const thirdPersonContent = thirdPersonMatch ? thirdPersonMatch[1] : \\\"暂无第三人称视角描述\\\";\\n                \\n                // 解析角色视角 - 使用[\\\\s\\\\S]*?替代.*?来匹配可能包含换行符的内容\\n                const characterViewMatch = shootContent.match(/\\\\[角色视角\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                const characterViewContent = characterViewMatch ? characterViewMatch[1] : \\\"暂无角色视角描述\\\";\\n                \\n                // 解析角色状态\\n                const statusMatch = shootContent.match(/\\\\[角色状态\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                const physicalStatus = statusMatch ? statusMatch[1] : \\\"无描述\\\";\\n                const mentalStatus = statusMatch ? statusMatch[2] : \\\"无描述\\\";\\n                \\n                // 解析拍摄流程\\n                const processList = [];\\n                const processMatches = Array.from(shootContent.matchAll(/\\\\[拍摄流程\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\|([\\\\s\\\\S]*?)\\\\]/g));\\n                \\n                processMatches.forEach(match => {\\n                    processList.push({\\n                        name: match[1],\\n                        description: match[2],\\n                        status: match[3]\\n                    });\\n                });\\n                \\n                return {\\n                    characterName,\\n                    characterOutfit,\\n                    thirdPersonContent,\\n                    characterViewContent,\\n                    physicalStatus,\\n                    mentalStatus,\\n                    processList\\n                };\\n            }\\n            \\n            // 模拟数据\\n            const sampleData = `\\n            <shoot>$1/shoot>\\n            `;\\n            \\n            // 解析数据并填充页面\\n            const shootData = parseShootData(sampleData);\\n            \\n            // 更新角色信息\\n            document.getElementById('character-name').textContent = shootData.characterName;\\n            document.getElementById('character-outfit').textContent = shootData.characterOutfit;\\n            document.getElementById('physical-status').textContent = shootData.physicalStatus;\\n            document.getElementById('mental-status').textContent = shootData.mentalStatus;\\n            \\n            // 处理文本格式化\\n            function formatContent(text) {\\n                // 创建文档片段，用于存储格式化后的内容\\n                const fragment = document.createDocumentFragment();\\n                \\n                // 如果文本为空，返回默认文本\\n                if (!text) {\\n                    const defaultText = document.createElement('p');\\n                    defaultText.textContent = \\\"暂无内容\\\";\\n                    fragment.appendChild(defaultText);\\n                    return fragment;\\n                }\\n                \\n                // 分割文本为段落 - 使用两个或多个连续换行符作为段落分隔符\\n                // 或使用明确的[p]标记作为段落分隔符\\n                const paragraphs = text.split(/\\\\n\\\\n+|\\\\[p\\\\]/g);\\n                \\n                // 为每个段落创建一个p元素\\n                paragraphs.forEach(paragraph => {\\n                    // 跳过空段落\\n                    if (!paragraph.trim()) return;\\n                    \\n                    // 创建段落元素\\n                    const p = document.createElement('p');\\n                    \\n                    // 处理单个换行符\\n                    const parts = paragraph.trim().split('\\\\n');\\n                    \\n                    // 添加第一部分\\n                    if (parts.length > 0) {\\n                        p.appendChild(document.createTextNode(parts[0]));\\n                    }\\n                    \\n                    // 添加剩余部分，每部分之间插入<br>\\n                    for (let i = 1; i < parts.length; i++) {\\n                        p.appendChild(document.createElement('br'));\\n                        p.appendChild(document.createTextNode(parts[i]));\\n                    }\\n                    \\n                    // 添加到片段\\n                    fragment.appendChild(p);\\n                });\\n                \\n                return fragment;\\n            }\\n            \\n            // 更新视角内容\\n            const thirdPersonContainer = document.getElementById('third-person-content');\\n            const characterContainer = document.getElementById('character-content');\\n            \\n            // 清空现有内容\\n            thirdPersonContainer.innerHTML = '';\\n            characterContainer.innerHTML = '';\\n            \\n            // 添加格式化后的内容\\n            thirdPersonContainer.appendChild(formatContent(shootData.thirdPersonContent));\\n            characterContainer.appendChild(formatContent(shootData.characterViewContent));\\n            \\n            // 更新拍摄流程列表\\n            const processList = document.getElementById('process-list');\\n            processList.innerHTML = ''; // 清空列表\\n            \\n            shootData.processList.forEach((process, index) => {\\n                let statusClass = '';\\n                let statusText = '';\\n                let fastForwardButton = '';\\n                \\n                switch(process.status) {\\n                    case '已完成':\\n                        statusClass = 'status-completed';\\n                        statusText = '已完成';\\n                        break;\\n                    case '进行中':\\n                        statusClass = 'status-in-progress';\\n                        statusText = '进行中';\\n                        break;\\n                    default:\\n                        statusClass = 'status-pending';\\n                        statusText = '未开始';\\n                        // 添加快进按钮，仅对未开始的项目显示\\n                        fastForwardButton = `<div class=\\\"fast-forward-btn\\\" data-process-name=\\\"${process.name}\\\" data-process-index=\\\"${index}\\\">\\n                            <i class=\\\"fas fa-forward\\\"></i>\\n                        </div>`;\\n                        break;\\n                }\\n                \\n                const listItem = document.createElement('li');\\n                listItem.className = 'process-item';\\n                listItem.innerHTML = `\\n                    <div class=\\\"process-header\\\">\\n                        <div class=\\\"process-number\\\">${index + 1}</div>\\n                        <div class=\\\"process-name\\\">${process.name}</div>\\n                        <div class=\\\"process-status ${statusClass}\\\">${statusText}</div>\\n                        ${fastForwardButton}\\n                    </div>\\n                    <div class=\\\"process-description\\\">${process.description}</div>\\n                `;\\n                \\n                processList.appendChild(listItem);\\n            });\\n            \\n            // 为快进按钮添加点击事件\\n            document.querySelectorAll('.fast-forward-btn').forEach(button => {\\n                button.addEventListener('click', function() {\\n                    const processName = this.getAttribute('data-process-name');\\n                    const processIndex = parseInt(this.getAttribute('data-process-index'));\\n                    \\n                    // 显示确认弹窗\\n                    const modal = document.getElementById('fast-forward-modal');\\n                    const targetSpan = document.getElementById('fast-forward-target');\\n                    targetSpan.textContent = processName;\\n                    \\n                    // 存储目标流程名称，供确认时使用\\n                    modal.setAttribute('data-target-process', processName);\\n                    modal.setAttribute('data-target-index', processIndex);\\n                    \\n                    // 显示弹窗\\n                    modal.classList.add('active');\\n                });\\n            });\\n            \\n            // 设置确认弹窗按钮事件\\n            document.getElementById('confirm-fast-forward').addEventListener('click', function() {\\n                const modal = document.getElementById('fast-forward-modal');\\n                const targetProcess = modal.getAttribute('data-target-process');\\n                const targetIndex = parseInt(modal.getAttribute('data-target-index'));\\n                \\n                if (targetProcess) {\\n                    // 构建命令消息\\n                    const message = `【拍摄界面】快进拍摄流程至${targetProcess}，前面的所有拍摄项目设定为已完成`;\\n                    \\n                    // 触发命令\\n                    if (typeof triggerSlash === 'function') {\\n                        triggerSlash(`/send ${message}|/trigger`);\\n                    } else {\\n                        console.log(message);\\n                    }\\n                }\\n                \\n                // 关闭弹窗\\n                modal.classList.remove('active');\\n            });\\n            \\n            // 设置取消按钮事件\\n            document.getElementById('cancel-fast-forward').addEventListener('click', function() {\\n                const modal = document.getElementById('fast-forward-modal');\\n                modal.classList.remove('active');\\n            });\\n            \\n            // 获取当前进行中的拍摄环节\\n            function getCurrentProcess() {\\n                const currentIndex = shootData.processList.findIndex(p => p.status === '进行中');\\n                if (currentIndex >= 0) {\\n                    return {\\n                        currentProcess: shootData.processList[currentIndex],\\n                        nextProcess: currentIndex + 1 < shootData.processList.length ? shootData.processList[currentIndex + 1] : null\\n                    };\\n                }\\n                return { currentProcess: null, nextProcess: null };\\n            }\\n            \\n            // 重拍按钮\\n            document.getElementById('reshoot-btn').addEventListener('click', function() {\\n                const { currentProcess } = getCurrentProcess();\\n                \\n                if (currentProcess) {\\n                    const message = `【拍摄界面】重新拍摄${currentProcess.name}，该环节要求：${currentProcess.description}`;\\n                    triggerSlash(`/send ${message}|/trigger`);\\n                } else {\\n                    console.log('没有正在进行的拍摄环节');\\n                }\\n            });\\n            \\n            // 下一步按钮\\n            document.getElementById('next-btn').addEventListener('click', function() {\\n                const { currentProcess, nextProcess } = getCurrentProcess();\\n                \\n                if (currentProcess && nextProcess) {\\n                    const message = `【拍摄界面】当前${currentProcess.name}环节已完成，拍摄${nextProcess.name}，该环节要求：${nextProcess.description}`;\\n                    triggerSlash(`/send ${message}|/trigger`);\\n                } else if (!currentProcess && shootData.processList.length > 0) {\\n                    // 如果没有进行中的环节，开始第一个未完成的环节\\n                    const firstPendingIndex = shootData.processList.findIndex(p => p.status === '未完成');\\n                    if (firstPendingIndex >= 0) {\\n                        const nextProcess = shootData.processList[firstPendingIndex];\\n                        const message = `【拍摄界面】开始拍摄${nextProcess.name}，该环节要求：${nextProcess.description}`;\\n                        triggerSlash(`/send ${message}|/trigger`);\\n                    } else {\\n                        console.log('所有拍摄环节已完成');\\n                    }\\n                } else {\\n                    console.log('没有下一个拍摄环节');\\n                }\\n            });\\n            \\n            // 完成拍摄按钮\\n            document.getElementById('complete-btn').addEventListener('click', function() {\\n                const message = `【结算界面】当前全部拍摄已完成，${shootData.characterName}拍摄的影片成功发行`;\\n                triggerSlash(`/send ${message}|/trigger`);\\n            });\\n            \\n            // 设置发送按钮和输入框事件\\n            const sendButton = document.getElementById('send-button');\\n            const dialogueInput = document.getElementById('dialogue-input');\\n            \\n            // 发送按钮点击事件\\n            sendButton.addEventListener('click', function() {\\n                sendDialogue();\\n            });\\n            \\n            // 输入框回车键事件\\n            dialogueInput.addEventListener('keypress', function(event) {\\n                if (event.key === 'Enter') {\\n                    sendDialogue();\\n                }\\n            });\\n            \\n            // 发送对话内容\\n            function sendDialogue() {\\n                const content = dialogueInput.value.trim();\\n                \\n                if (!content) return;\\n                \\n                // 获取当前进行中的拍摄环节\\n                const { currentProcess } = getCurrentProcess();\\n                const processName = currentProcess ? currentProcess.name : \\\"当前环节\\\";\\n                \\n                // 向主应用发送消息\\n                const message = `【拍摄界面】继续${processName}的拍摄：${content}`;\\n                triggerSlash(`/send ${message}|/trigger`);\\n                \\n                // 清空输入框\\n                dialogueInput.value = '';\\n                \\n                // 可选：提供一些视觉反馈\\n                showSendFeedback();\\n            }\\n            \\n            // 发送成功的反馈\\n            function showSendFeedback() {\\n                // 创建一个临时元素显示发送成功\\n                const feedback = document.createElement('div');\\n                feedback.style.position = 'fixed';\\n                feedback.style.bottom = '80px';\\n                feedback.style.left = '50%';\\n                feedback.style.transform = 'translateX(-50%)';\\