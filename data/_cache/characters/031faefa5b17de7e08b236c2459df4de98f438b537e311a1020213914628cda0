 successContainer.className = 'success-message';\\n                    successContainer.innerHTML = '<i class=\\\"fas fa-check-circle\\\"></i> <span id=\\\"success-message\\\"></span>';\\n                    document.body.appendChild(successContainer);\\n                }\\n                \\n                const successMessage = document.getElementById('success-message');\\n                if (successMessage) {\\n                    successMessage.textContent = message;\\n                    successContainer.style.display = 'flex';\\n                    successContainer.classList.add('show');\\n                    \\n                    setTimeout(() => {\\n                        successContainer.classList.remove('show');\\n                        setTimeout(() => {\\n                            successContainer.style.display = 'none';\\n                        }, 300);\\n                    }, 3000);\\n                }\\n            },\\n            \\n            // 添加日志功能，支持调试模式\\n            log(message, ...args) {\\n                if (this.isDebugMode) {\\n                    console.log(`[AppState] ${message}`, ...args);\\n                }\\n            },\\n            \\n            // 添加警告日志\\n            warn(message, ...args) {\\n                if (this.isDebugMode) {\\n                    console.warn(`[AppState警告] ${message}`, ...args);\\n                }\\n            },\\n            \\n            // 添加错误日志（始终显示）\\n            error(message, ...args) {\\n                console.error(`[AppState错误] ${message}`, ...args);\\n                // 在调试模式下，也在界面上显示错误\\n                if (this.isDebugMode) {\\n                    this.showError(`调试错误: ${message}`);\\n                }\\n            },\\n            \\n            // 检查DOM元素是否存在的辅助方法\\n            checkElement(id, type=\\\"正常\\\") {\\n                const element = document.getElementById(id);\\n                if (!element) {\\n                    this.warn(`找不到${type}元素:`, id);\\n   