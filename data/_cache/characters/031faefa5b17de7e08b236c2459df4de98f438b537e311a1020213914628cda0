;\\n            height: 100%;\\n            background: linear-gradient(to bottom, var(--secondary-color), var(--primary-color));\\n            border-radius: 2px;\\n        }\\n        \\n        .interview-card h2 {\\n            font-family: 'Orbitron', sans-serif;\\n            color: var(--secondary-color);\\n            margin-bottom: 20px;\\n            font-size: 1.4rem;\\n            padding-left: 15px;\\n            display: flex;\\n            align-items: center;\\n        }\\n        \\n        .interview-card h2 i {\\n            margin-right: 10px;\\n        }\\n        \\n        .dialogue-list {\\n            list-style: none;\\n            display: flex;\\n            flex-direction: column;\\n            gap: 25px;\\n        }\\n        \\n        .dialogue-item {\\n            display: flex;\\n            flex-direction: column;\\n            gap: 10px;\\n        }\\n        \\n        .question-container, .answer-container {\\n            display: flex;\\n            gap: 15px;\\n        }\\n        \\n        .avatar {\\n            width: 40px;\\n            height: 40px;\\n            border-radius: 50%;\\n            display: flex;\\n            align-items: center;\\n            justify-content: center;\\n            flex-shrink: 0;\\n            font-weight: bold;\\n            color: var(--dark-bg);\\n        }\\n        \\n        .reporter-avatar {\\n            background: linear-gradient(45deg, var(--secondary-color), var(--accent-color));\\n        }\\n        \\n        .character-avatar {\\n            background: linear-gradient(45deg, var(--primary-color), var(--primary-variant));\\n        }\\n        \\n        /* 错误消息样式 */\\n        .error-message {\\n            background-color: rgba(255, 87, 87, 0.2);\\n            color: #ff5757;\\n            padding: 15px;\\n            border-radius: 8px;\\n            margin: 0 0 15px 0;\\n            display: none;\\n        }\\n        \\n        .error-message.show {\\n            display: block;\\n            animation: shake 0.5s ease-in-out;\\n        }\\n        \\n        @keyframes shake {\\n            0%, 100% { transform: translateX(0); }\\n            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }\\n            20%, 40%, 60%, 80% { transform: translateX(5px); }\\n        }\\n        \\n        .dialogue-bubble {\\n            background-color: rgba(18, 18, 31, 0.7);\\n            border-radius: 10px;\\n            padding: 15px;\\n            position: relative;\\n            flex-grow: 1;\\n        }\\n        \\n        .question-bubble {\\n            border: 1px solid rgba(3, 218, 198, 0.2);\\n        }\\n        \\n        .answer-bubble {\\n            border: 1px solid rgba(187, 134, 252, 0.2);\\n        }\\n        \\n        .dialogue-text {\\n            line-height: 1.6;\\n        }\\n        \\n        .question-text {\\n            color: var(--secondary-color);\\n        }\\n        \\n        .answer-text {\\n            color: var(--text-secondary);\\n        }\\n        \\n        /* 角色肢体动作和表情样式 */\\n        .character-action {\\n            color: #ffab40; /* 橙黄色，更突出表情动作 */\\n            font-style: italic;\\n            opacity: 0.85;\\n            font-size: 0.95em;\\n            display: inline-block;\\n            transition: all 0.3s ease;\\n        }\\n        \\n        .character-action:hover {\\n            opacity: 1;\\n            text-shadow: 0 0 5px rgba(255, 171, 64, 0.4);\\n        }\\n        \\n        .dialogue-text p {\\n            margin-bottom: 10px;\\n        }\\n        \\n        .dialogue-text p:last-child {\\n            margin-bottom: 0;\\n        }\\n        \\n        /* 气泡尖角 */\\n        .question-bubble::before {\\n            content: '';\\n            position: absolute;\\n            left: -10px;\\n            top: 15px;\\n            border-width: 10px 10px 10px 0;\\n            border-style: solid;\\n            border-color: transparent rgba(18, 18, 31, 0.7) transparent transparent;\\n        }\\n        \\n        .answer-bubble::before {\\n            content: '';\\n            position: absolute;\\n            left: -10px;\\n            top: 15px;\\n            border-width: 10px 10px 10px 0;\\n            border-style: solid;\\n            border-color: transparent rgba(18, 18, 31, 0.7) transparent transparent;\\n        }\\n        \\n        /* 底部按钮区域 */\\n        .action-buttons {\\n            display: flex;\\n            justify-content: center;\\n            gap: 15px;\\n            margin-top: 25px;\\n        }\\n        \\n        .action-button {\\n            padding: 12px 25px;\\n            border-radius: 10px;\\n            font-family: 'Orbitron', sans-serif;\\n            font-size: 1rem;\\n            border: none;\\n            cursor: pointer;\\n            transition: all 0.3s ease;\\n            display: flex;\\n            align-items: center;\\n            justify-content: center;\\n        }\\n        \\n        .action-button i {\\n            margin-right: 8px;\\n        }\\n        \\n        .confirm-button {\\n            background: linear-gradient(45deg, var(--secondary-color), var(--accent-color));\\n            color: var(--dark-bg);\\n            min-width: 200px;\\n        }\\n        \\n        .confirm-button:hover {\\n            box-shadow: 0 0 15px rgba(3, 218, 198, 0.7);\\n            transform: translateY(-2px);\\n        }\\n        \\n        .back-button {\\n            background-color: rgba(187, 134, 252, 0.1);\\n            color: var(--primary-color);\\n            border: 1px solid var(--primary-color);\\n            min-width: 200px;\\n        }\\n        \\n        .back-button:hover {\\n            background-color: rgba(187, 134, 252, 0.2);\\n            box-shadow: 0 0 15px rgba(187, 134, 252, 0.5);\\n            transform: translateY(-2px);\\n        }\\n        \\n        .after-button {\\n            background-color: rgba(255, 171, 64, 0.1);\\n            color: #ffab40;\\n            border: 1px solid #ffab40;\\n            min-width: 200px;\\n        }\\n        \\n        .after-button:hover {\\n            background-color: rgba(255, 171, 64, 0.2);\\n            box-shadow: 0 0 15px rgba(255, 171, 64, 0.5);\\n            transform: translateY(-2px);\\n        }\\n        \\n        /* 输入框和发送按钮样式 */\\n        .input-container {\\n            display: flex;\\n            margin: 20px 0;\\n            gap: 10px;\\n        }\\n        \\n        .dialogue-input {\\n            flex-grow: 1;\\n            padding: 12px 15px;\\n            border-radius: 10px;\\n            background-color: rgba(18, 18, 31, 0.7);\\n            border: 1px solid rgba(187, 134, 252, 0.2);\\n            color: var(--text-primary);\\n            font-size: 0.95rem;\\n            transition: all 0.3s ease;\\n            font-family: 'Roboto', sans-serif;\\n        }\\n        \\n        .dialogue-input:focus {\\n            outline: none;\\n            border-color: var(--primary-color);\\n            box-shadow: 0 0 10px rgba(187, 134, 252, 0.3);\\n        }\\n        \\n        .dialogue-input::placeholder {\\n            color: rgba(255, 255, 255, 0.4);\\n        }\\n        \\n        .send-button {\\n            padding: 12px 20px;\\n            border-radius: 10px;\\n            background: linear-gradient(45deg, var(--primary-color), var(--primary-variant));\\n            color: var(--dark-bg);\\n            border: none;\\n            font-family: 'Orbitron', sans-serif;\\n            font-size: 0.9rem;\\n            cursor: pointer;\\n            transition: all 0.3s ease;\\n            display: flex;\\n            align-items: center;\\n            justify-content: center;\\n            min-width: 100px;\\n        }\\n        \\n        .send-button i {\\n            margin-right: 6px;\\n        }\\n        \\n        .send-button:hover {\\n            transform: translateY(-2px);\\n            box-shadow: 0 0 15px rgba(187, 134, 252, 0.5);\\n        }\\n        \\n        /* 加载动画 */\\n        .loading-overlay {\\n            position: fixed;\\n            top: 0;\\n            left: 0;\\n            width: 100%;\\n            height: 100%;\\n            background-color: rgba(10, 10, 18, 0.8);\\n            display: flex;\\n            justify-content: center;\\n            align-items: center;\\n            z-index: 1000;\\n            opacity: 0;\\n            visibility: hidden;\\n            transition: all 0.3s ease;\\n        }\\n        \\n        .loading-overlay.active {\\n            opacity: 1;\\n            visibility: visible;\\n        }\\n        \\n        .loading-spinner {\\n            width: 60px;\\n            height: 60px;\\n            border: 5px solid transparent;\\n            border-top-color: var(--primary-color);\\n            border-radius: 50%;\\n            animation: spin 1s linear infinite;\\n        }\\n        \\n        @keyframes spin {\\n            0% { transform: rotate(0deg); }\\n            100% { transform: rotate(360deg); }\\n        }\\n        \\n        /* 滚动条样式 */\\n        ::-webkit-scrollbar {\\n            width: 6px;\\n        }\\n        \\n        ::-webkit-scrollbar-track {\\n            background: rgba(255, 255, 255, 0.05);\\n            border-radius: 3px;\\n        }\\n        \\n        ::-webkit-scrollbar-thumb {\\n            background: var(--primary-color);\\n            border-radius: 3px;\\n        }\\n        \\n        ::-webkit-scrollbar-thumb:hover {\\n            background: var(--primary-variant);\\n        }\\n        \\n        /* 响应式设计 */\\n        @media (max-width: 768px) {\\n            .header {\\n                flex-direction: column;\\n                align-items: flex-start;\\n            }\\n            \\n            .status-info {\\n                margin-top: 15px;\\n                align-items: flex-start;\\n            }\\n            \\n            .question-container, .answer-container {\\n                flex-direction: column;\\n            }\\n            \\n            .question-bubble::before, .answer-bubble::before {\\n                display: none;\\n            }\\n            \\n            .action-buttons {\\n                flex-direction: column;\\n            }\\n            \\n            .action-button {\\n                width: 100%;\\n            }\\n        }\\n    </style>\\n</head>\\n<body>\\n    <div class=\\\"container\\\">\\n        <!-- 头部信息 -->\\n        <div class=\\\"header\\\">\\n            <div class=\\\"character-info\\\">\\n                <span class=\\\"character-label\\\">角色名称</span>\\n                <span class=\\\"character-name\\\" id=\\\"character-name\\\">未加载</span>\\n            </div>\\n            <div class=\\\"status-info\\\">\\n                <span class=\\\"status-label\\\">当前状态</span>\\n                <span class=\\\"status-value\\\">媒体访谈</span>\\n            </div>\\n        </div>\\n        \\n        <!-- 错误消息显示区域 -->\\n        <div class=\\\"error-message\\\" id=\\\"error-container\\\">\\n            <i class=\\\"fas fa-exclamation-triangle\\\"></i> <span id=\\\"error-message\\\">错误信息将显示在这里</span>\\n        </div>\\n        \\n        <!-- 主要内容区域 -->\\n        <div class=\\\"content-container\\\">\\n            <!-- 影片简介卡片 -->\\n            <div class=\\\"synopsis-card\\\">\\n                <h2><i class=\\\"fas fa-film\\\"></i> 影片简介</h2>\\n                <div class=\\\"synopsis-content\\\" id=\\\"synopsis-content\\\">\\n                    正在加载内容...\\n                </div>\\n            </div>\\n            \\n            <!-- 访谈对话卡片 -->\\n            <div class=\\\"interview-card\\\">\\n                <h2><i class=\\\"fas fa-microphone-alt\\\"></i> 访谈对话</h2>\\n                <ul class=\\\"dialogue-list\\\" id=\\\"dialogue-list\\\">\\n                    <!-- 对话将通过JS动态添加 -->\\n                    <li class=\\\"dialogue-item\\\">\\n                        <div class=\\\"question-container\\\">\\n                            <div class=\\\"avatar reporter-avatar\\\">R</div>\\n                            <div class=\\\"dialogue-bubble question-bubble\\\">\\n                                <div class=\\\"dialogue-text question-text\\\">加载中...</div>\\n                            </div>\\n                        </div>\\n                        <div class=\\\"answer-container\\\">\\n                            <div class=\\\"avatar character-avatar\\\">C</div>\\n                            <div class=\\\"dialogue-bubble answer-bubble\\\">\\n                                <div class=\\\"dialogue-text answer-text\\\">加载中...</div>\\n                            </div>\\n                        </div>\\n                    </li>\\n                </ul>\\n                \\n                <!-- 输入框和发送按钮 -->\\n                <div class=\\\"input-container\\\">\\n                    <input type=\\\"text\\\" class=\\\"dialogue-input\\\" id=\\\"dialogue-input\\\" placeholder=\\\"在此处作为记者向演员提问...\\\">\\n                    <button class=\\\"send-button\\\" id=\\\"send-button\\\">\\n                        <i class=\\\"fas fa-paper-plane\\\"></i> 发送\\n                    </button>\\n                </div>\\n                \\n                <!-- 操作按钮 -->\\n                <div class=\\\"action-buttons\\\">\\n                    <button class=\\\"action-button confirm-button\\\" id=\\\"continue-button\\\">\\n                        <i class=\\\"fas fa-check\\\"></i> 继续提问\\n                    </button>\\n                    <button class=\\\"action-button back-button\\\" id=\\\"back-button\\\">\\n                        <i class=\\\"fas fa-arrow-left\\\"></i> 返回主界面\\n                    </button>\\n                    <button class=\\\"action-button after-button\\\" id=\\\"after-button\\\">\\n                        <i class=\\\"fas fa-fast-forward\\\"></i> 进入日后谈\\n                    </button>\\n                </div>\\n            </div>\\n        </div>\\n    </div>\\n    \\n    <!-- 加载动画 -->\\n    <div class=\\\"loading-overlay\\\" id=\\\"loading-overlay\\\">\\n        <div class=\\\"loading-spinner\\\"></div>\\n    </div>\\n\\n    <script>\\n        // 全局状态管理\\n        const AppState = {\\n            isLoading: false,\\n            characterName: '',\\n            synopsis: '',\\n            dialogues: [], // 存储问答对\\n            \\n            // 设置加载状态\\n            setLoading(loading) {\\n                this.isLoading = loading;\\n                const overlay = document.getElementById('loading-overlay');\\n                if (loading) {\\n                    overlay.classList.add('active');\\n                } else {\\n                    overlay.classList.remove('active');\\n                }\\n            },\\n            \\n            // 显示错误消息\\n            showError(message) {\\n                console.error('错误:', message);\\n                // 使用自定义错误UI\\n                const errorContainer = document.getElementById('error-container');\\n                const errorMessage = document.getElementById('error-message');\\n                \\n                if (errorContainer && errorMessage) {\\n                    errorMessage.textContent = message;\\n                    errorContainer.classList.add('show');\\n                    \\n                    // 5秒后自动隐藏\\n                    setTimeout(() => {\\n                        errorContainer.classList.remove('show');\\n                    }, 5000);\\n                }\\n            },\\n            \\n            // 显示成功消息\\n            showSuccess(message) {\\n                console.log('成功:', message);\\n                // 使用自定义错误UI元素但显示成功样式\\n                const errorContainer = document.getElementById('error-container');\\n                const errorMessage = document.getElementById('error-message');\\n                \\n                if (errorContainer && errorMessage) {\\n                    // 修改样式为成功状态\\n                    errorContainer.style.backgroundColor = 'rgba(3, 218, 198, 0.2)';\\n                    errorMessage.style.color = '#03dac6';\\n                    \\n                    // 更新消息内容\\n                    errorMessage.textContent = message;\\n                    errorContainer.classList.add('show');\\n                    \\n                    // 3秒后自动隐藏\\n                    setTimeout(() => {\\n                        errorContainer.classList.remove('show');\\n                        // 恢复原始样式\\n                        errorContainer.style.backgroundColor = '';\\n                        errorMessage.style.color = '';\\n                    }, 3000);\\n                }\\n            }\\n        };\\n        \\n        // 数据提取模块\\n        const DataExtractor = {\\n            // 解析访谈数据\\n            parseInterviewData(text) {\\n                try {\\n                    // 正则匹配整个interview标签内容\\n                    const interviewMatch = text.match(/<interview>([\\\\s\\\\S]*?)<\\\\/interview>/);\\n                    if (!interviewMatch) return null;\\n                    \\n                    const interviewContent = interviewMatch[1].trim();\\n                    \\n                    // 提取角色姓名\\n                    const nameMatch = interviewContent.match(/\\\\[角色姓名\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const characterName = nameMatch ? nameMatch[1] : '未知角色';\\n                    \\n                    // 提取影片简介\\n                    const synopsisMatch = interviewContent.match(/\\\\[影片简介\\\\|([\\\\s\\\\S]*?)\\\\]/);\\n                    const synopsis = synopsisMatch ? synopsisMatch[1] : '暂无影片简介';\\n                    \\n                    // 提取所有记者提问和角色回答配对\\n                    const dialogues = [];\\n                    \\n                    // 使用正则匹配所有记者提问\\n                    const questionMatches = Array.from(interviewContent.matchAll(/\\\\[记者提问\\\\|([\\\\s\\\\S]*?)\\\\]/g));\\n                    // 使用正则匹配所有角色回答\\n                    const answerMatches = Array.from(interviewContent.matchAll(/\\\\[角色回答\\\\|([\\\\s\\\\S]*?)\\\\]/g));\\n                    \\n                    // 确保提问和回答的数量匹配\\n                    const count = Math.min(questionMatches.length, answerMatches.length);\\n                    \\n                    for (let i = 0; i < count; i++) {\\n                        dialogues.push({\\n                            question: questionMatches[i][1],\\n                            answer: answerMatches[i][1]\\n                        });\\n                    }\\n                    \\n                    return {\\n                        characterName,\\n                        synopsis,\\n                        dialogues\\n                    };\\n                } catch (error) {\\n                    console.error('解析访谈数据出错:', error);\\n                    return null;\\n                }\\n            }\\n        };\\n        \\n        // 数据渲染模块\\n        const UI = {\\n            // 渲染角色姓名\\n            renderCharacterName(name) {\\n                document.getElementById('character-name').textContent = name;\\n            },\\n            \\n            // 渲染影片简介\\n            renderSynopsis(text) {\\n                const synopsisContent = document.getElementById('synopsis-content');\\n                \\n                // 清空现有内容\\n                synopsisContent.innerHTML = '';\\n                \\n                // 分段处理文本\\n                if (text) {\\n                    const formattedContent = this.formatText(text);\\n                    synopsisContent.appendChild(formattedContent);\\n                } else {\\n                    synopsisContent.textContent = '暂无影片简介';\\n                }\\n            },\\n            \\n            // 渲染对话列表\\n            renderDialogueList(dialogues) {\\n                const dialogueList = document.getElementById('dialogue-list');\\n                dialogueList.innerHTML = '';\\n                \\n                if (!dialogues || dialogues.length === 0) {\\n                    const emptyItem = document.createElement('li');\\n                    emptyItem.className = 'dialogue-item';\\n                    emptyItem.innerHTML = `\\n                        <div class=\\\"dialogue-bubble\\\">\\n                            <div class=\\\"dialogue-text\\\">暂无访谈内容</div>\\n                        </div>\\n                    `;\\n                    dialogueList.appendChild(emptyItem);\\n                    return;\\n                }\\n                \\n                dialogues.forEach((dialogue, index) => {\\n                    const dialogueItem = document.createElement('li');\\n                    dialogueItem.className = 'dialogue-item';\\n                    \\n                    // 创建提问部分\\n                    const questionContainer = document.createElement('div');\\n                    questionContainer.className = 'question-container';\\n                    \\n                    // 创建记者头像（默认使用字母R）\\n                    const reporterAvatar = document.createElement('div');\\n                    reporterAvatar.className = 'avatar reporter-avatar';\\n                    reporterAvatar.textContent = 'R';\\n                    \\n                    // 创建提问气泡\\n                    const questionBubble = document.createElement('div');\\n                    questionBubble.className = 'dialogue-bubble question-bubble';\\n                    \\n                    // 创建提问文本容器\\n                    const questionText = document.createElement('div');\\n                    questionText.className = 'dialogue-text question-text';\\n                    \\n                    // 格式化提问文本\\n                    questionText.appendChild(this.formatText(dialogue.question));\\n                    \\n                    // 组装提问部分\\n                    questionBubble.appendChild(questionText);\\n                    questionContainer.appendChild(reporterAvatar);\\n                    questionContainer.appendChild(questionBubble);\\n                    \\n                    // 创建回答部分\\n                    const answerContainer = document.createElement('div');\\n                    answerContainer.className = 'answer-container';\\n                    \\n                    // 创建角色头像（使用角色姓名的第一个字符）\\n                    const characterAvatar = document.createElement('div');\\n                    characterAvatar.className = 'avatar character-avatar';\\n                    characterAvatar.textContent = AppState.characterName.charAt(0) || 'C';\\n                    \\n                    // 创建回答气泡\\n                    const answerBubble = document.createElement('div');\\n                    answerBubble.className = 'dialogue-bubble answer-bubble';\\n                    \\n                    // 创建回答文本容器\\n                    const answerText = document.createElement('div');\\n                    answerText.className = 'dialogue-text answer-text';\\n                    \\n                    // 格式化回答文本\\n                    answerText.appendChild(this.formatText(dialogue.answer));\\n                    \\n                    // 组装回答部分\\n                    answerBubble.appendChild(answerText);\\n                    answerContainer.appendChild(characterAvatar);\\n                    answerContainer.appendChild(answerBubble);\\n                    \\n                    // 组装整个对话项\\n                    dialogueItem.appendChild(questionContainer);\\n                    dialogueItem.appendChild(answerContainer);\\n                    \\n                    // 添加到对话列表\\n                    dialogueList.appendChild(dialogueItem);\\n                });\\n            },\\n            \\n            // 文本格式化函数，处理段落和换行\\n            formatText(text) {\\n                // 创建文档片段，用于存储格式化后的内容\\n                const fragment = document.createDocumentFragment();\\n                \\n                // 如果文本为空，返回默认文本\\n                if (!text) {\\n                    const defaultText = document.createElement('p');\\n               