    cards.forEach((card, index) => {\\n                        // 首先重置所有卡片的状态和样式\\n                        card.classList.remove('active', 'prev', 'next');\\n                        card.style.transform = '';\\n                        card.style.opacity = '0';\\n                        card.style.visibility = 'hidden';\\n                        \\n                        // 给当前卡片添加active类\\n                        if (index === currentIndex) {\\n                            card.classList.add('active');\\n                            card.style.transform = 'translate(-50%, -50%) scale(1)';\\n                            card.style.opacity = '1';\\n                            card.style.visibility = 'visible';\\n                            \\n                            // 添加高亮动画\\n                            card.classList.add('highlight');\\n                            setTimeout(() => {\\n                                card.classList.remove('highlight');\\n                            }, 2000);\\n                            \\n                            AppState.log(`激活卡片 ${index}: ${card.querySelector('h3').textContent}`);\\n                            \\n                            // 确保按钮是可见和可点击的\\n                            const saveButton = card.querySelector('.save-button');\\n                            const contactButton = card.querySelector('.contact-button');\\n                            if (saveButton) {\\n                                saveButton.style.pointerEvents = 'auto';\\n                                saveButton.style.opacity = '1';\\n                                saveButton.style.visibility = 'visible';\\n                            }\\n                            if (contactButton) {\\n                                contactButton.style.pointerEvents = 'auto';\\n                                contactButton.style.opacity = '1';\\n                                contactButton.style.visibility = 'visible';\\n                            }\\n                        } \\n                        // 给前一个卡片添加prev类\\n                        else if (index === (currentIndex - 1 + totalCards) % totalCards) {\\n                            card.classList.add('prev');\\n                            card.style.transform = 'translate(calc(-50% - 250px), -50%) scale(0.85)';\\n                            card.style.opacity = '0.8';\\n                            card.style.visibility = 'visible';\\n                        } \\n                        // 给后一个卡片添加next类\\n                        else if (index === (currentIndex + 1) % totalCards) {\\n                            card.classList.add('next');\\n                            card.style.transform = 'translate(calc(-50% + 250px), -50%) scale(0.85)';\\n                            card.style.opacity = '0.8';\\n                            card.style.visibility = 'visible';\\n                        }\\n                    });\\n                    \\n                    // 更新控制点样式\\n                    dots.forEach((dot, index) => {\\n                        if (index === currentIndex) {\\n                            dot.classList.add('active');\\n                        } else {\\n                            dot.classList.remove('active');\\n                        }\\n                    });\\n                    \\n                    // 更新应用状态\\n                    AppState.setCurrentCharacter(currentIndex);\\n                    \\n                    // 触发角色切换事件\\n                    const event = new CustomEvent('character-changed', { detail: { index: currentIndex } });\\n                    document.dispatchEvent(event);\\n                }\\n                \\n                // 为保存按钮和联系按钮单独添加调试点击处理\\n                document.querySelectorAll('.save-button').forEach((button) => {\\n                    button.addEventListener('click', (e) => {\\n                        e.preventDefault();\\n                        e.stopPropagation();\\n                        const cardIndex = parseInt(button.closest('.character-card').dataset.index);\\n                        AppState.log(`直接点击保存按钮，卡片索引: ${cardIndex}`);\\n                        console.log('保存按钮元素:', button);\\n                        console.log('父卡片:', button.closest('.character-card'));\\n                        saveCharacter(cardIndex);\\n                    });\\n                });\\n                \\n                document.querySelectorAll('.contact-button').forEach((button) => {\\n                    button.addEventListener('click', (e) => {\\n                        e.preventDefault();\\n                        e.stopPropagation();\\n                        const cardIndex = parseInt(button.closest('.character-card').dataset.index);\\n                        AppState.log(`直接点击联系按钮，卡片索引: ${cardIndex}`);\\n                        console.log('联系按钮元素:', button);\\n                        console.log('父卡片:', button.closest('.character-card'));\\n                        selectCharacter(cardIndex);\\n                    });\\n                });\\n                \\n                // 切换到特定卡片的函数\\n                function goToCard(index) {\\n                    const previousIndex = currentIndex;\\n                    currentIndex = (index + totalCards) % totalCards;\\n                    AppState.log(`轮播切换: ${previousIndex} -> ${currentIndex}`);\\n                    updateCarousel();\\n                }\\n                \\n                // 为左右切换按钮添加事件处理\\n                prevBtn.addEventListener('click', () => {\\n                    AppState.log('点击前一个按钮');\\n                    goToCard(currentIndex - 1);\\n                });\\n                \\n                nextBtn.addEventListener('click', () => {\\n                    AppState.log('点击后一个按钮');\\n                    goToCard(currentIndex + 1);\\n                });\\n                \\n                // 为每个卡片添加点击事件\\n                cards.forEach((card, index) => {\\n                    card.addEventListener('click', (e) => {\\n                        // 记录点击事件\\n                        AppState.log(`卡片点击: 索引=${index}, 类名=${card.className}, 点击元素=${e.target.tagName}${e.target.className ? '.' + e.target.className : ''}`);\\n                        \\n                        // 如果点击的是左侧卡片(prev)，切换到前一个\\n                        if (card.classList.contains('prev')) {\\n                            AppState.log('点击了左侧卡片，前移');\\n                            goToCard(currentIndex - 1);\\n                        }\\n                        // 如果点击的是右侧卡片(next)，切换到后一个\\n                        else if (card.classList.contains('next')) {\\n                            AppState.log('点击了右侧卡片，后移');\\n                            goToCard(currentIndex + 1);\\n                        }\\n                        // 如果是点击活动卡片上的某些元素，也要处理点击事件\\n                        else if (card.classList.contains('active')) {\\n                            // 如果点击的是卡片内部的可折叠区域标题或内容，不做导航操作\\n                            if (e.target.closest('.info-group-title') || e.target.closest('.info-content')) {\\n                                AppState.log('点击了当前卡片内容区域，不做导航');\\n                                return;\\n                            }\\n                            \\n                            AppState.log(\\\"点击了活动卡片\\\", index);\\n                        }\\n                    });\\n                });\\n                \\n                // 为控制点添加点击事件\\n                dots.forEach((dot, index) => {\\n                    dot.addEventListener('click', () => {\\n                        AppState.log(`点击控制点 ${index}`);\\n                        goToCard(index);\\n                    });\\n                });\\n                \\n                // 添加触摸滑动支持\\n                let touchStartX = 0;\\n                let touchEndX = 0;\\n                \\n                const carousel = document.querySelector('.carousel');\\n                \\n                carousel.addEventListener('touchstart', (e) => {\\n                    touchStartX = e.changedTouches[0].screenX;\\n                });\\n                \\n                carousel.addEventListener('touchend', (e) => {\\n                    touchEndX = e.changedTouches[0].screenX;\\n                    handleSwipe();\\n                });\\n                \\n                function handleSwipe() {\\n                    const minSwipeDistance = 50;\\n                    if (touchEndX < touchStartX - minSwipeDistance) {\\n                        // 左滑\\n                        goToCard(currentIndex + 1);\\n                    } else if (touchEndX > touchStartX + minSwipeDistance) {\\n                        // 右滑\\n                        goToCard(currentIndex - 1);\\n                    }\\n                }\\n                \\n                // 初始化轮播\\n                updateCarousel();\\n                \\n                // 暴露接口以供外部使用\\n                window.carousel = {\\n                    goToCard: goToCard,\\n                    getCurrentIndex: () => currentIndex\\n                };\\n            } catch (error) {\\n                console.error('设置轮播出错:', error);\\n                AppState.showError('初始化角色选择界面时出错');\\n            }\\n        }\\n        \\n        // 处理角色选择\\n        function selectCharacter(index) {\\n            try {\\n                if (AppState.isLoading) {\\n                    AppState.log('系统正在加载中，忽略点击');\\n                    return; // 如果正在加载中，不允许选择\\n                }\\n                \\n                // 确保索引是整数\\n                index = parseInt(index);\\n                \\n                const selectedCard = document.querySelector(`.character-card[data-index=\\\"${index}\\\"]`);\\n                if (!selectedCard) {\\n                    console.error(`找不到索引为 ${index} 的卡片`);\\n                    return;\\n                }\\n                \\n                // 检查卡片是否是活跃状态，如果不是则不处理\\n                if (!selectedCard.classList.contains('active')) {\\n                    AppState.log(`卡片 ${index} 不是活跃状态，不处理联系操作`);\\n                    // 如果卡片不是活跃状态，激活该卡片\\n                    if (window.carousel && typeof window.carousel.goToCard === 'function') {\\n                        AppState.log(`自动激活卡片 ${index}`);\\n                        window.carousel.goToCard(index);\\n                        // 短暂延迟后再次尝试联系\\n                        setTimeout(() => {\\n                            selectCharacter(index);\\n                        }, 600);\\n                    }\\n                    return;\\n                }\\n                \\n                const characterName = selectedCard.querySelector('h3').textContent;\\n                AppState.log(`已选择角色: ${characterName}, 索引: ${index}`);\\n                \\n                // 显示加载中\\n                AppState.setLoading(true);\\n                \\n                // 模拟异步操作（实际应用中可能是向服务器发送请求）\\n                setTimeout(() => {\\n                    try {\\n                        // 隐藏加载中\\n                        AppState.setLoading(false);\\n                        \\n                        // 创建命令列表\\n                        const commands = [];\\n                        \\n                        // 添加联系角色的命令（不再保存角色信息到世界书）\\n                        commands.push(`/send 【聊天界面】{{User}}决定联系${characterName},发送一条我方消息：你好，我是{{User}}，我想和你合作拍摄一部影片`);\\n                        commands.push(`/trigger`);\\n                        \\n                        // 发送triggerSlash消息\\n                        if (typeof triggerSlash === 'function') {\\n                            const commandString = commands.join('|');\\n                            AppState.log(\\\"发送的命令:\\\", commandString);\\n                            triggerSlash(commandString);\\n                        } else {\\n                            console.error('triggerSlash 函数不可用');\\n                            AppState.showError('联系失败：triggerSlash 函数不可用');\\n                        }\\n                        \\n                        // 触发选择角色事件\\n                        const event = new CustomEvent('character-selected', { \\n                            detail: { \\n                                index: index,\\n                                name: characterName\\n                            } \\n                        });\\n                        document.dispatchEvent(event);\\n                    } catch (error) {\\n                        AppState.error('执行角色联系操作时出错', error);\\n                    }\\n                }, 500); // 减少延迟时间\\n            } catch (error) {\\n                console.error('选择角色出错:', error);\\n                AppState.setLoading(false);\\n                AppState.showError('选择角色时发生错误');\\n            }\\n        }\\n        \\n        // 设置信息组展开/折叠功能\\n        function setupInfoToggle() {\\n            const toggles = document.querySelectorAll('.info-toggle');\\n            \\n            toggles.forEach(toggle => {\\n                toggle.addEventListener('click', () => {\\n                    const icon = toggle.querySelector('i');\\n                    const content = toggle.parentElement.nextElementSibling;\\n                    \\n                    if (content.classList.contains('collapsed')) {\\n                        content.classList.remove('collapsed');\\n                        icon.classList.remove('fa-chevron-down');\\n                        icon.classList.add('fa-chevron-up');\\n                    } else {\\n                        content.classList.add('collapsed');\\n                        icon.classList.remove('fa-chevron-up');\\n                        icon.classList.add('fa-chevron-down');\\n                    }\\n                });\\n            });\\n        }\\n        \\n        // 数据提取模块\\n        const DataExtractor = {\\n            // 提取基本信息\\n            extractBasicInfo(text) {\\n                const basicInfoMatch = text.match(/<basic_info>([\\\\s\\\\S]*?)<\\\\/basic_info>/);\\n                if (!basicInfoMatch) return null;\\n                \\n                const basicInfoText = basicInfoMatch[1].trim();\\n                \\n                // 提取时间\\n                const timeMatch = basicInfoText.match(/\\\\[时间\\\\|(.*?)\\\\|(.*?)\\\\]/);\\n                const date = timeMatch ? timeMatch[1] : '未知日期';\\n                const time = timeMatch ? timeMatch[2] : '未知时间';\\n                \\n                // 提取工作室知名度\\n                const ratingMatch = basicInfoText.match(/\\\\[工作室知名度\\\\|(.*?)\\\\]/);\\n                const rating = ratingMatch ? parseFloat(ratingMatch[1]) : 3.0;\\n                \\n                return { date, time, rating };\\n            },\\n            \\n            // 提取角色信息\\n            extractCharacterInfo(text, characterNum) {\\n                const charMatch = text.match(new RegExp(`<character${characterNum}>([\\\\\\\\\\\\s\\\\\\\\\\\\S]*?)<\\\\/character${characterNum}>`));\\n                if (!charMatch) return null;\\n                \\n                const charText = charMatch[1].trim();\\n                \\n                // 提取基本信息\\n                const basicInfoMatch = charText.match(/\\\\[角色基本信息\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\]/);\\n                const name = basicInfoMatch ? basicInfoMatch[1] : '未知';\\n                const age = basicInfoMatch ? basicInfoMatch[2] : '未知';\\n                const personality = basicInfoMatch ? basicInfoMatch[3] : '未知';\\n                const background = basicInfoMatch ? basicInfoMatch[4] : '未知';\\n                \\n                // 提取外貌信息\\n                const appearanceMatch = charText.match(/\\\\[角色外貌信息\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\]/);\\n                const height = appearanceMatch ? appearanceMatch[1] : '未知';\\n                const weight = appearanceMatch ? appearanceMatch[2] : '未知';\\n                const cup = appearanceMatch ? appearanceMatch[3] : '未知';  // 新增罩杯字段\\n                const hairColor = appearanceMatch ? appearanceMatch[4] : '未知';\\n                const hairStyle = appearanceMatch ? appearanceMatch[5] : '未知';\\n                const clothes = appearanceMatch ? appearanceMatch[6] : '未知';\\n                const shoes = appearanceMatch ? appearanceMatch[7] : '未知';\\n                const accessory = appearanceMatch ? appearanceMatch[8] : '未知';\\n                \\n                // 提取性爱信息 - 处理可能的不同字段名称格式\\n                let sexualInfoMatch = charText.match(/\\\\[角色性爱信息\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\|(.*?)\\\\]/);\\n                \\n                const isVirgin = sexualInfoMatch ? sexualInfoMatch[1] : '未知';\\n                const sexualExp = sexualInfoMatch ? sexualInfoMatch[2] : '未知';\\n                const sexualPref = sexualInfoMatch ? sexualInfoMatch[3] : '未知';\\n                const pussyState = sexualInfoMatch ? sexualInfoMatch[4] : '未知';\\n                const analState = sexualInfoMatch ? sexualInfoMatch[5] : '未知';\\n                const oralState = sexualInfoMatch ? sexualInfoMatch[6] : '未知';\\n                const trainingState = sexualInfoMatch ? sexualInfoMatch[7] : '未知';\\n                \\n                // 提取接受内容 - 统一使用\\\"角色可接受内容\\\"标签\\n                const acceptMatch = charText.match(/\\\\[角色可接受内容\\\\|(.*?)\\\\]/);\\n                const acceptContent = acceptMatch ? acceptMatch[1].split('|') : [];\\n                \\n                // 提取拒绝内容 - 统一使用\\\"角色不可接受内容\\\"标签\\n                const rejectMatch = charText.match(/\\\\[角色不可接受内容\\\\|(.*?)\\\\]/);\\n                const rejectContent = rejectMatch ? rejectMatch[1].split('|') : [];\\n                \\n                // 提取底线 - 统一使用\\\"角色底线\\\"标签\\n                const bottomLineMatch = charText.match(/\\\\[角色底线\\\\|(.*?)\\\\]/);\\n                const bottomLine = bottomLineMatch ? bottomLineMatch[1].split('|') : [];\\n                \\n                // 提取弱点\\n                const weaknessMatch = charText.match(/\\\\[角色弱点\\\\|(.*?)\\\\]/);\\n                const weakness = weaknessMatch ? weaknessMatch[1].split('|') : [];\\n                \\n                // 提取策略\\n                const strategyMatch = charText.match(/\\\\[建议策略\\\\|(.*?)\\\\]/);\\n                const strategy = strategyMatch ? strategyMatch[1] : '未知';\\n                \\n                return {\\n                    name, age, personality, background,\\n                    height, weight, cup, hairColor, hairStyle, clothes, shoes, accessory,  // 添加cup到返回值中\\n                    isVirgin, sexualExp, sexualPref, pussyState, analState, oralState, trainingState,\\n                    acceptContent, rejectContent, bottomLine, weakness, strategy\\n                };\\n            },\\n            \\n            // 提取所有数据\\n            extractAllData(text) {\\n                const basicInfo = this.extractBasicInfo(text);\\n                const character1 = this.extractCharacterInfo(text, 1);\\n                const character2 = this.extractCharacterInfo(text, 2);\\n                const character3 = this.extractCharacterInfo(text, 3);\\n                \\n                return { basicInfo, character1, character2, character3 };\\n            }\\n        };\\n        \\n        // 数据显示模块\\n        const DataRenderer = {\\n            // 渲染基本信息\\n            renderBasicInfo(basicInfo) {\\n                if (!basicInfo) return;\\n                \\n                // 设置从数据中读取的日期和时间\\n                document.getElementById('current-date').textContent = basicInfo.date || '未知日期';\\n                document.getElementById('current-time').textContent = basicInfo.time || '未知时间';\\n                \\n                // 更新工作室评分\\n                updateRating(basicInfo.rating);\\n            },\\n            \\n            // 渲染角色信息\\n            renderCharacterInfo(character, charNum) {\\n                if (!character) return;\\n                \\n                // 更新标题\\n                document.querySelector(`.character-card[data-index=\\\"${charNum-1}\\\"] h3`).textContent = character.name;\\n                \\n                // 更新基本信息\\n                document.getElementById(`char${charNum}-name`).textContent = character.name;\\n                document.getElementById(`char${charNum}-age`).textContent = character.age;\\n                document.getElementById(`char${charNum}-personality`).textContent = character.personality;\\n                document.getElementById(`char${charNum}-background`).textContent = character.background;\\n                \\n                // 更新外貌信息\\n                document.getElementById(`char${charNum}-height`).textContent = character.height;\\n                document.getElementById(`char${charNum}-weight`).textContent = character.weight;\\n                document.getElementById(`char${charNum}-cup`).textContent = character.cup;  // 添加罩杯渲染\\n                document.getElementById(`char${charNum}-hair`).textContent = character.hairColor;\\n                document.getElementById(`char${charNum}-hairstyle`).textContent = character.hairStyle;\\n                document.getElementById(`char${charNum}-clothes`).textContent = character.clothes;\\n                document.getElementById(`char${charNum}-shoes`).textContent = character.shoes;\\n                document.getElementById(`char${charNum}-accessory`).textContent = character.accessory;\\n                \\n                // 更新性爱信息\\n                document.getElementById(`char${charNum}-virgin`).textContent = character.isVirgin;\\n                document.getElementById(`char${charNum}-exp`).textContent = character.sexualExp;\\n                document.getElementById(`char${charNum}-pref`).textContent = character.sexualPref;\\n                document.getElementById(`char${charNum}-pussy`).textContent = character.pussyState;\\n                document.getElementById(`char${charNum}-anal`).textContent = character.analState;\\n                document.getElementById(`char${charNum}-oral`).textContent = character.oralState;\\n                document.getElementById(`char${charNum}-training`).textContent = character.trainingState;\\n                \\n                // 更新接受内容列表\\n                const acceptsList = document.getElementById(`char${charNum}-accepts`);\\n                acceptsList.innerHTML = '';\\n                character.acceptContent.forEach(item => {\\n                    const li = document.createElement('li');\\n                    li.textContent = item;\\n                    acceptsList.appendChild(li);\\n                });\\n                \\n                // 更新拒绝内容列表\\n                const rejectsList = document.getElementById(`char${charNum}-rejects`);\\n                rejectsList.innerHTML = '';\\n                character.rejectContent.forEach(item => {\\n                    const li = document.createElement('li');\\n                    li.textContent = item;\\n                    rejectsList.appendChild(li);\\n                });\\n                \\n                // 更新底线与弱点，直接显示完整文本\\n                const limitsList = document.getElementById(`char${charNum}-limit`);\\n                limitsList.textContent = Array.isArray(character.bottomLine) ? character.bottomLine.join('，') : character.bottomLine;\\n                \\n                const weaknessList = document.getElementById(`char${charNum}-weakness`);\\n                weaknessList.textContent = Array.isArray(character.weakness) ? character.weakness.join('，') : character.weakness;\\n                \\n                // 更新策略\\n                document.getElementById(`char${charNum}-strategy`).textContent = character.strategy;\\n            },\\n            \\n            // 渲染所有数据\\n            renderAllData(data) {\\n                this.renderBasicInfo(data.basicInfo);\\n                this.renderCharacterInfo(data.character1, 1);\\n                this.renderCharacterInfo(data.character2, 2);\\n                this.renderCharacterInfo(data.character3, 3);\\n            },\\n            \\n            // 添加监听事件处理\\n            setupEventListeners() {\\n                // 监听角色切换事件\\n                document.addEventListener('character-changed', (e) => {\\n                    const index = e.detail.index;\\n                    console.log(`当前展示角色索引: ${index}`);\\n                });\\n                \\n                // 监听角色选择事件\\n                document.addEventListener('character-selected', (e) => {\\n                    const {index, name} = e.detail;\\n                    console.log(`已选择角色: ${name}，索引: ${index}`);\\n                    // 可以在这里添加跳转到下一个界面的逻辑\\n                });\\n            }\\n        };\\n        \\n        // 处理接收到的游戏数据\\n        function processGameData(text) {\\n            try {\\n                AppState.setLoading(true);\\n                \\n                setTimeout(() => {\\n                    const data = DataExtractor.extractAllData(text);\\n                    if (!data.basicInfo || !data.character1) {\\n                        throw new Error('无法解析游戏数据');\\n                    }\\n                    \\n                    AppState.characters = [data.character1, data.character2, data.character3].filter(Boolean);\\n                    DataRenderer.renderAllData(data);\\n                    \\n                    AppState.setLoading(false);\\n                }, 800); // 添加延迟以显示加载效果\\n            } catch (error) {\\n                console.error('处理游戏数据出错:', error);\\n                AppState.setLoading(false);\\n                AppState.showError('处理游戏数据时出错: ' + error.message);\\n            }\\n        }\\n        \\n        // 初始化\\n        document.addEventListener('DOMContentLoaded', function() {\\n            try {\\n                // 设置轮播\\n                setupCarousel();\\n                \\n                // 设置搜索功能\\n                setupSearch();\\n                \\n                // 设置信息组的展开/折叠切换\\n                setupInfoToggle();\\n                \\n                // 初始化数据\\n                const data = DataExtractor.extractAllData(gameText);\\n                DataRenderer.renderAllData(data);\\n            } catch (error) {\\n                console.error('初始化页面出错:', error);\\n                AppState.showError('初始化页面时发生错误');\\n            }\\n        });\\n        \\n        // 不需要自定义实现triggerSlash函数，它是由外部环境提供的\\n        \\n        // 初始化搜索功能\\n        function setupSearch() {\\n            try {\\n                const searchInput = document.querySelector('.search-input');\\n                const searchButton = document.querySelector('.search-button');\\n                \\n                // 处理搜索按钮点击\\n                searchButton.addEventListener('click', () => {\\n                    const searchText = searchInput.value.trim();\\n                    if (!searchText) return;\\n                    \\n                    // 执行triggerSlash消息发送\\n                    if (typeof triggerSlash === 'function') {\\n                        triggerSlash(`/send 【主界面】更新角色，新的角色要求：${searchText}|/trigger`);\\n                        console.log(`已发送搜索请求: ${searchText}`);\\n                        \\n                        // 清空搜索框\\n                        searchInput.value = '';\\n                    } else {\\n                        console.error('triggerSlash 函数不可用');\\n                        AppState.showError('无法发送搜索请求');\\n                    }\\n                });\\n                \\n                // 处理回车键搜索\\n                searchInput.addEventListener('keypress', (e) => {\\n                    if (e.key === 'Enter') {\\n                        const searchText = searchInput.value.trim();\\n                        if (searchText) {\\n                            // 执行triggerSlash消息发送\\n                            if (typeof triggerSlash === 'function') {\\n                                triggerSlash(`/send 【主界面】更新角色，新的角色要求：${searchText}|/trigger`);\\n                                console.log(`已