gameSystem.initialize()\\n            console.log('页面已加载，等待用户点击启动按钮');\\n        });\\n\\n        // 血液粒子效果\\n        function createBloodParticles() {\\n            const container = document.createElement('div');\\n            container.className = 'blood-particle-container';\\n            document.body.appendChild(container);\\n            \\n            // 添加血液粒子样式\\n            const styleElement = document.createElement('style');\\n            styleElement.textContent = `\\n                .blood-particle {\\n                    position: absolute;\\n                    background: linear-gradient(135deg, #a30000 0%, #590000 100%);\\n                    border-radius: 50%;\\n                    top: -10px;\\n                    animation: bloodFall 8s cubic-bezier(0.215, 0.61, 0.355, 1) forwards;\\n                    box-shadow: 0 0 8px 1px rgba(0, 0, 0, 0.3);\\n                    z-index: 1000;\\n                    filter: blur(0.7px);\\n                }\\n                \\n                @keyframes bloodFall {\\n                    0% {\\n                        top: -10px;\\n                        opacity: 0.9;\\n                        transform: scale(1) translateX(0) rotate(0deg);\\n                    }\\n                    15% {\\n                        transform: scale(1.1) translateX(10px) rotate(10deg);\\n                    }\\n                    35% {\\n                        transform: scale(1.2) translateX(-15px) rotate(-5deg);\\n                    }\\n                    55% {\\n                        transform: scale(0.95) translateX(8px) rotate(15deg);\\n                    }\\n                    75% {\\n                        transform: scale(0.9) translateX(-5px) rotate(-10deg);\\n                    }\\n                    100% {\\n                        top: 120%;\\n                        opacity: 0.1;\\n                        transform: scale(0.7) translateX(-10px) rotate(20deg);\\n                    }\\n                }\\n                \\n                .blood-splash {\\n                    position: absolute;\\n                    background: radial-gradient(ellipse at center, rgba(170, 0, 0, 0.8) 0%, rgba(100, 0, 0, 0.6) 30%, rgba(100, 0, 0, 0) 70%);\\n                    border-radius: 50%;\\n                    animation: splashFade 2.5s cubic-bezier(0.19, 1, 0.22, 1) forwards;\\n                    z-index: 999;\\n                    pointer-events: none;\\n                    filter: blur(1px);\\n                    mix-blend-mode: multiply;\\n                }\\n                \\n                @keyframes splashFade {\\n                    0% {\\n                        transform: scale(0);\\n                        opacity: 0.95;\\n                    }\\n                    30% {\\n                        opacity: 0.8;\\n                    }\\n                    100% {\\n                        transform: scale(1);\\n                        opacity: 0;\\n                    }\\n                }\\n                \\n                .blood-drop {\\n                    position: absolute;\\n                    background: linear-gradient(to bottom, #a30000, #590000);\\n                    box-shadow: 0 0 3px 0px rgba(0, 0, 0, 0.5);\\n                    filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.2));\\n                    border-radius: 50% 50% 50% 0;\\n                    transform-origin: center bottom;\\n                    z-index: 1001;\\n                    animation: dropFall 1.8s cubic-bezier(0.645, 0.045, 0.355, 1) forwards;\\n                }\\n                \\n                @keyframes dropFall {\\n                    0% {\\n                        transform: translateY(-10px) rotate(0deg) scale(1);\\n                        opacity: 0.9;\\n                    }\\n                    30% {\\n                        transform: translateY(10px) rotate(15deg) scale(0.95);\\n                        opacity: 0.85;\\n                    }\\n                    100% {\\n                        transform: translateY(100px) rotate(-15deg) scale(0.6);\\n                        opacity: 0;\\n                    }\\n                }\\n            `;\\n            document.head.appendChild(styleElement);\\n            \\n            function createParticle() {\\n                const particle = document.createElement('div');\\n                particle.className = 'blood-particle';\\n                \\n                // 随机位置\\n                const xPos = Math.random() * 100;\\n                particle.style.left = `${xPos}%`;\\n                \\n                // 随机大小 - 较为均衡的尺寸\\n                const size = 4 + Math.random() * 10;\\n                particle.style.width = `${size}px`;\\n                particle.style.height = `${size}px`;\\n                \\n                // 随机动画延迟\\n                const delay = Math.random() * 3; \\n                particle.style.animationDelay = `${delay}s`;\\n                \\n                // 随机颜色变化 - 深红色调\\n                const hue = 0; // 红色色相\\n                const saturation = 80 + Math.floor(Math.random() * 20); // 饱和度\\n                const lightness = 20 + Math.floor(Math.random() * 15); // 亮度\\n                particle.style.background = `linear-gradient(135deg, hsl(${hue}, ${saturation}%, ${lightness+10}%) 0%, hsl(${hue}, ${saturation}%, ${lightness-10}%) 100%)`;\\n                \\n                // 随机不透明度\\n                const opacity = 0.75 + Math.random() * 0.25;\\n                particle.style.opacity = opacity;\\n                \\n                // 随机旋转\\n                const rotation = Math.random() * 360;\\n                particle.style.transform = `rotate(${rotation}deg)`;\\n                \\n                container.appendChild(particle);\\n                \\n                // 移除粒子\\n                setTimeout(() => {\\n                    particle.remove();\\n                }, 8000);\\n                \\n                // 随机生成飞溅效果\\n                if (Math.random() > 0.7) {\\n                    setTimeout(() => {\\n                        createBloodSplash(xPos, Math.random() * 80 + 10);\\n                    }, (delay + 1 + Math.random() * 3) * 1000);\\n                }\\n            }\\n            \\n            function createBloodSplash(x, y) {\\n                const splash = document.createElement('div');\\n                splash.className = 'blood-splash';\\n                \\n                // 位置\\n                splash.style.left = `${x}%`;\\n                splash.style.top = `${y}%`;\\n                \\n                // 大小\\n                const size = 30 + Math.random() * 50;\\n                splash.style.width = `${size}px`;\\n                splash.style.height = `${size}px`;\\n                \\n                container.appendChild(splash);\\n                \\n                // 创建飞溅drops\\n                const dropCount = 2 + Math.floor(Math.random() * 3);\\n                for (let i = 0; i < dropCount; i++) {\\n                    createBloodDrop(x, y);\\n                }\\n                \\n                // 移除飞溅\\n                setTimeout(() => {\\n                    splash.remove();\\n                }, 2500);\\n            }\\n            \\n            function createBloodDrop(x, y) {\\n                const drop = document.createElement('div');\\n                drop.className = 'blood-drop';\\n                \\n                // 位置\\n                const offsetX = -10 + Math.random() * 20;\\n                const offsetY = -5 + Math.random() * 10;\\n                drop.style.left = `calc(${x}% + ${offsetX}px)`;\\n                drop.style.top = `calc(${y}% + ${offsetY}px)`;\\n                \\n                // 大小和旋转\\n                const size = 3 + Math.random() * 6;\\n                drop.style.width = `${size}px`;\\n                drop.style.height = `${size * 1.5}px`;\\n                \\n                // 随机旋转和方向\\n                const rotation = Math.random() * 360;\\n                drop.style.transform = `rotate(${rotation}deg)`;\\n                \\n                container.appendChild(drop);\\n                \\n                // 移除飞滴\\n                setTimeout(() => {\\n                    drop.remove();\\n                }, 1800);\\n            }\\n            \\n            // 初始创建一些粒子\\n            for (let i = 0; i < 20; i++) {\\n                createParticle();\\n            }\\n            \\n            // 定期创建新粒子 - 适中频率\\n            setInterval(() => {\\n                createParticle();\\n            }, 300);\\n            \\n            // 随机创建血液飞溅 - 较低频率\\n            setInterval(() => {\\n                if (Math.random() > 0.3) {\\n                    const randX = Math.random() * 100;\\n                    const randY = Math.random() * 70 + 15;\\n                    createBloodSplash(randX, randY);\\n                }\\n            }, 1500);\\n        }\\n        \\n        // 初始化卡片动画\\n        function initializeCardAnimations() {\\n            const cards = document.querySelectorAll('.option-card');\\n            cards.forEach((card, index) => {\\n                card.style.setProperty('--card-index', index);\\n            });\\n        }\\n        \\n        // 删除未使用的函数和重复的事件监听器\\n        \\n        // 直接在HTML元素上添加内联onclick事件\\n        function startButtonClick(event) {\\n            console.log('启动按钮被点击了!');\\n            \\n            const mainContainer = document.querySelector('.main-container');\\n            const startScreen = document.querySelector('.start-screen');\\n            \\n            if (!mainContainer || !startScreen) {\\n                console.error('找不到必要的DOM元素!');\\n                alert('初始化失败，请刷新页面重试。');\\n                return;\\n            }\\n            \\n            // 显示主容器，隐藏开始屏幕\\n            startScreen.style.opacity = '0';\\n            mainContainer.style.display = 'block';\\n            \\n            // 定义角色系统对象（如果未定义）\\n      