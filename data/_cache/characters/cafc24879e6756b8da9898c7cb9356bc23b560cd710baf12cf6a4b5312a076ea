环境和对手状态，制定最佳战略）',\\n                    'ironwill': '钢铁意志（意志坚定如钢铁，不会被恐惧、痛苦或诱惑所动摇）',\\n                    \\n                    // 观众天赋\\n                    'insight': '洞察（能看透对手的心理，预判他们的行动）',\\n                    'connections': '人脉（认识竞技场内外的各色人物，获取有价值的情报）',\\n                    'gambler': '赌徒（在危险的赌注中获得额外收益）',\\n                    'manipulator': '操控者（能够影响他人的决策，暗中引导事态发展）',\\n                    'judge': '审判者（精准评估角斗士实力，找出致命弱点）',\\n                    'psychology': '心理大师（深谙人性，能轻易看穿谎言和弱点）',\\n                    'bribery': '贿赂大师（知道谁需要什么，用最小的代价换取最大的利益）',\\n                    'trendspotter': '趋势发现者（能预测比赛和赌局走势，抓住最佳时机）',\\n                    'rumor': '谣言大师（善于制造和传播谣言，影响比赛和赌局）',\\n                    'blackmail': '把柄收集者（收集他人把柄和秘密，在关键时刻利用）',\\n                    'coldblood': '冷血（毫无情感波动，能做出最理性的决策和下注）',\\n                    'mentor': '导师（能通过指导和建议影响角斗士发挥出最大潜力）',\\n                    \\n                    // 通用天赋\\n                    'luck': '幸运（命运女神的青睐，关键时刻转危为安）',\\n                    'instinct': '直觉（对危险的第六感，反应快于思考）',\\n                    'charisma': '魅力（慑人的气场，赢取观众或对手的认同）',\\n                    'cunning': '狡诈（出其不意的策略，总能找到突破口）',\\n                    'focus': '专注（即使在混乱中也能保持清醒的思考）',\\n                    'adaptability': '适应力（迅速适应各种环境和情况的能力，化被动为主动）',\\n                    'willpower': '意志力（不屈的精神，即使面对最严峻的挑战也能坚持下去）',\\n                    'intuition': '洞察力（能够看穿表象，理解事物的本质和他人的意图）',\\n                    'resourcefulness': '随机应变（善于利用手边的资源解决问题，永远有B计划）',\\n                    'persuasion': '说服力（言辞犀利，能让他人接受你的观点和建议）',\\n                    'vigilance': '警觉（对周围环境保持高度警惕，很少被偷袭或欺骗）',\\n                    'fearlessness': '无畏（面对危险毫无恐惧，敢于直面任何挑战和威胁）'\\n                };\\n                \\n                const talents = this.player.talents.map(t => talentNames[t] || t).join('、');\\n                openingText += `天赋：${talents || \\\"无\\\"}\\\\n`;\\n                \\n                // 处理自定义天赋\\n                if (this.player.customTalents && Object.keys(this.player.customTalents).length > 0) {\\n                    openingText += `自定义天赋：\\\\n`;\\n                    \\n                    Object.entries(this.player.customTalents).forEach(([key, talent]) => {\\n                        openingText += `  - ${talent.name}（${talent.desc}）\\\\n`;\\n                    });\\n                }\\n                \\n                // 尝试使用多种方法发送开场白\\n                try {\\n                    console.log('尝试发送开场白到AI:', openingText);\\n                    \\n                    // 方法1：使用triggerSlashWithResult\\n                    if (typeof triggerSlashWithResult === 'function') {\\n                        console.log('使用triggerSlashWithResult方法');\\n                        // 使用send命令直接发送用户消息\\n                        const result = await triggerSlashWithResult(`/send ${openingText}|/trigger await=true`);\\n                        console.log('triggerSlashWithResult结果:', result);\\n                        return;\\n                    }\\n                    \\n                    // 方法2：使用triggerSlash\\n                    if (typeof triggerSlash === 'function') {\\n                        console.log('使用triggerSlash方法');\\n                        await triggerSlash(`/send ${openingText}|/trigger await=true`);\\n                        return;\\n                    }\\n                    \\n                    // 方法3：直接使用SillyTavern接口\\n                    if (typeof SillyTavern !== 'undefined' && SillyTavern.sendSystemMessage) {\\n                        console.log('使用SillyTavern.sendSystemMessage方法');\\n                        SillyTavern.sendSystemMessage(openingText);\\n                        return;\\n                    }\\n                    \\n                    // 方法4：通过添加到聊天历史\\n                    if (typeof SillyTavern !== 'undefined' && SillyTavern.getContext && SillyTavern.getContext().chat) {\\n                        console.log('尝试直接添加到聊天历史');\\n                        // 获取当前聊天对象\\n                        const chat = SillyTavern.getContext().chat;\\n                        // 向聊天中添加用户消息\\n                        if (chat.push && typeof chat.push === 'function') {\\n                            chat.push({\\n                                name: this.player.name || 'User',\\n                                is_user: true,\\n                                is_system: false,\\n                                send_date: Date.now(),\\n                                mes: openingText\\n                            });\\n                            console.log('已添加到聊天历史');\\n                            return;\\n                        }\\n                    }\\n                    \\n                    // 方法5：使用setChatMessage\\n                    if (typeof setChatMessage === 'function' && typeof getCurrentMessageId === 'function') {\\n                        console.log('使用setChatMessage方法');\\n                        setChatMessage(openingText, getCurrentMessageId());\\n                        return;\\n                    }\\n                    \\n                    // 所有方法都失败，记录消息\\n                    console.log('无法发送开场白给AI，请手动复制以下文本发送：', openingText);\\n                    \\n                    // 创建一个包含复制功能的提示\\n                    const copyElement = document.createElement('div');\\n                    copyElement.className = 'copy-message';\\n                    copyElement.innerHTML = `\\n                        <p>无法自动发送消息给AI。</p>\\n                        <textarea id=\\\"copy-text\\\" readonly style=\\\"width: 100%; height: 100px; margin: 10px 0; padding: 5px; background: #333; color: #fff; border: 1px solid #444;\\\">${openingText}</textarea>\\n                        <button id=\\\"copy-button\\\" style=\\\"padding: 5px 10px; background: #ff2a2a; color: white; border: none; cursor: pointer;\\\">复制文本</button>\\n                    `;\\n                    copyElement.style.cssText = `\\n                        position: fixed;\\n                        top: 50%;\\n                        left: 50%;\\n                        transform: translate(-50%, -50%);\\n                        background: rgba(0, 0, 0, 0.9);\\n                        color: white;\\n                        padding: 20px;\\n                        border-radius: 5px;\\n                        z-index: 9999;\\n                        box-shadow: 0 0 20px rgba(0, 0, 0, 0.7);\\n                        max-width: 80%;\\n                    `;\\n                    \\n                    // 添加到DOM\\n                    document.body.appendChild(copyElement);\\n\\n                    // 添加复制按钮功能\\n                    const copyButton = document.getElementById('copy-button');\\n                    const copyText = document.getElementById('copy-text');\\n                    \\n                    copyButton.addEventListener('click', () => {\\n                        copyText.select();\\n                        document.execCommand('copy');\\n                        copyButton.textContent = '已复制!';\\n                        copyButton.style.background = '#28a745';\\n                        \\n                        // 3秒后关闭提示\\n                        setTimeout(() => {\\n                            copyElement.remove();\\n                        }, 3000);\\n                    });\\n                    \\n                } catch (error) {\\n                    console.error('发送开场白失败:', error);\\n                    this.showError('无法发送消息。请手动进行角色扮演。');\\n                }\\n                \\n                // 游戏开始\\n                this.gameState = \\\"running\\\";\\n                this.updateUI();\\n            },\\n\\n            next() {\\n                // 检查当前步骤是否有效\\n                if (!this.validateCurrentStep()) {\\n                    return false;\\n                }\\n                \\n                // 增加步骤\\n                this.currentStep++;\\n                \\n                // 检查是否超出范围\\n                if (this.currentStep > this.maxSteps - 1) {\\n                    this.currentStep = this.maxSteps - 1;\\n                    return false;\\n                }\\n                \\n                // 特殊处理：如果不是角斗士角色且当前步骤是赌注步骤(2)，则自动跳到下一步\\n                if (this.player.role !== 'fighter' && this.currentStep === 2) {\\n                    console.log(\\\"观众角色，跳过赌注步骤\\\");\\n                    this.currentStep++;\\n                }\\n                \\n                // 初始化下一步\\n                this.initializeStep(this.currentStep);\\n                \\n                // 更新显示\\n                this.updateStepIndicator();\\n                this.updateStepContent();\\n                \\n                return true;\\n            },\\n            \\n            prev() {\\n                this.currentStep--;\\n                \\n                if (this.currentStep < 0) {\\n                    this.currentStep = 0;\\n                    return false;\\n                }\\n                \\n                // 特殊处理：观众角色需要跳过赌注步骤(2)\\n                if (this.player.role !== 'fighter' && this.currentStep === 2) {\\n                    console.log(\\\"观众角色，返回时跳过赌注步骤\\\");\\n                    this.currentStep--;\\n                }\\n                \\n                this.initializeStep(this.currentStep);\\n                this.updateStepIndicator();\\n                this.updateStepContent();\\n                \\n                return true;\\n            },\\n            \\n            validateCurrentStep() {\\n                console.log(`验证当前步骤: ${this.currentStep}`);\\n                let isValid = true;\\n                let errorMessage = '';\\n\\n                switch (this.currentStep) {\\n                    case 0: // 基本信息\\n                        if (this.player.creationMethod === 'custom') {\\n                            // 获取表单元素值\\n                            const nameInput = document.getElementById('char-name');\\n                            const ageInput = document.getElementById('char-age');\\n                            const appearanceInput = document.getElementById('char-appearance');\\n                            const genderSelect = document.getElementById('char-gender');\\n                            \\n                            // 提取值并验证\\n                            if (!nameInput || !nameInput.value.trim()) {\\n                                isValid = false;\\n                                errorMessage = '请输入角色名称';\\n                            } else if (!ageInput || !ageInput.value.trim()) {\\n                                isValid = false;\\n                                errorMessage = '请输入角色年龄';\\n                            } else if (parseInt(ageInput.value) < 16 || parseInt(ageInput.value) > 60) {\\n                                isValid = false;\\n                                errorMessage = '角色年龄必须在16-60岁之间';\\n                            } else if (!appearanceInput || !appearanceInput.value.trim()) {\\n                                isValid = false;\\n                                errorMessage = '请描述角色外观';\\n                            }\\n                            \\n                            // 保存到player对象\\n                            if (isValid) {\\n                                this.player.name = nameInput.value.trim();\\n                                this.player.age = ageInput.value.trim();\\n                                this.player.appearance = appearanceInput.value.trim();\\n                                if (genderSelect) {\\n                                    this.player.gender = genderSelect.value;\\n                                }\\n                            }\\n                        } else {\\n                            // 导入模式 - 使用特定文本表示导入的信息\\n                            this.player.name = '直接读取用户角色卡';\\n                            this.player.gender = '直接读取用户角色卡';\\n                            this.player.appearance = '直接读取用户角色卡';\\n                            this.player.age = '直接读取用户角色卡';\\n                        }\\n                        break;\\n                    case 1: // 角色选择\\n                        if (!this.player.role) {\\n                            isValid = false;\\n                            errorMessage = '请选择角色类型';\\n                        }\\n                        break;\\n                    case 2: // 赌注 (只对战斗者验证)\\n                if (this.player.role === 'fighter') {\\n                            if (!this.player.betType) {\\n                                isValid = false;\\n                                errorMessage = '请选择赌注类型';\\n                            } else if (this.player.betType === 'relative') {\\n                                // 验证亲属信息\\n                                const relativeNameInput = document.getElementById('relative-name');\\n                                const relativeRelationInput = document.getElementById('relative-relation');\\n                                \\n                                if (relativeNameInput && !relativeNameInput.value.trim()) {\\n                                    isValid = false;\\n                                    errorMessage = '请输入亲属姓名';\\n                                } else if (relativeRelationInput && !relativeRelationInput.value.trim()) {\\n                                    isValid = false;\\n                                    errorMessage = '请输入与亲属的关系';\\n                                } else {\\n                                    // 确保同步到player对象\\n                                    this.player.relativeName = relativeNameInput.value.trim();\\n                                    this.player.relativeRelation = relativeRelationInput.value.trim();\\n                                    \\n                                    // 获取描述信息（可选）\\n                                    const relativeDescriptionInput = document.getElementById('relative-description');\\n                                    if (relativeDescriptionInput) {\\n                                        this.player.relativeDescription = relativeDescriptionInput.value.trim();\\n                                    }\\n                                }\\n                            }\\n                    } else {\\n                            console.log(\\\"观众角色跳过赌注验证\\\");\\n                        }\\n                        break;\\n                    case 3: // 角色设定\\n                        if (this.player.role === 'fighter' && (!this.player.background || !this.player.skill || !this.player.motive)) {\\n                            isValid = false;\\n                            errorMessage = '请完成角色设定';\\n                        } else if (this.player.role === 'spectator' && !this.player.style) {\\n                            isValid = false;\\n                            errorMessage = '请选择观赛策略';\\n                        }\\n                        break;\\n                    case 4: // 天赋选择\\n                        if (this.player.talents.length === 0) {\\n                            isValid = false;\\n                            errorMessage = '请至少选择一个天赋';\\n                } else {\\n                            // 确保selectedTalents和player.talents同步\\n                            if (this.selectedTalents && this.selectedTalents.length > 0) {\\n                                this.player.talents = [...this.selectedTalents];\\n                                console.log(\\\"验证时同步天赋选择到player对象:\\\", this.player.talents);\\n                            } else if (this.player.talents && this.player.talents.length > 0) {\\n                                this.selectedTalents = [...this.player.talents];\\n                                console.log(\\\"验证时从player.talents同步到selectedTalents:\\\", this.selectedTalents);\\n                            }\\n                        }\\n                        break;\\n                }\\n                \\n                if (!isValid && errorMessage) {\\n                    this.showError(errorMessage);\\n                }\\n                \\n                return isValid;\\n            },\\n\\n            finalize() {\\n                // 检查是否已选择场景\\n                if (!this.player.scenario) {\\n                    this.showError(\\\"请选择一个开始场景\\\");\\n                    return;\\n                }\\n                \\n                // 直接提交，去掉confirm\\n                console.log(\\\"完成角色创建，准备提交\\\");\\n                \\n                // 清理玩家对象\\n                const characterData = { ...this.player };\\n                \\n                // 尝试传递给API接口或保存本地数据\\n                this.sendToAPI(characterData);\\n            },\\n            \\n            showError(message) {\\n                // 用非弹窗方式显示错误\\n                console.log(\\\"错误:\\\", message);\\n                \\n                // 创建一个临时的错误提示元素\\n                const errorElement = document.createElement('div');\\n                errorElement.className = 'error-message';\\n                errorElement.textContent = message;\\n                errorElement.style.cssText = `\\n                    position: fixed;\\n                    top: 20px;\\n                    left: 50%;\\n                    transform: translateX(-50%);\\n                    background: rgba(255, 0, 0, 0.8);\\n                    color: white;\\n                    padding: 10px 20px;\\n                    border-radius: 5px;\\n                    z-index: 9999;\\n                    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\\n                `;\\n                \\n                // 添加到DOM\\n                document.body.appendChild(errorElement);\\n                \\n                // 添加动画类\\n                setTimeout(() => {\\n                    errorElement.style.animation = 'notificationFadeIn 0.3s forwards';\\n                }, 10);\\n                \\n                // 3秒后自动淡出并移除\\n                setTimeout(() => {\\n                    errorElement.style.animation = 'notificationFadeOut 0.3s forwards';\\n                    setTimeout(() => {\\n                        errorElement.remove();\\n                    }, 300);\\n                }, 3000);\\n            },\\n            \\n            showSuccess(message) {\\n                // 用非弹窗方式显示成功消息\\n                console.log(\\\"成功:\\\", message);\\n                \\n                // 创建一个临时的成功提示元素\\n                const successElement = document.createElement('div');\\n                successElement.className = 'success-message';\\n                successElement.textContent = message;\\n                successElement.style.cssText = `\\n                    position: fixed;\\n                    top: 20px;\\n                    left: 50%;\\n                    transform: translateX(-50%);\\n                    background: rgba(40, 167, 69, 0.8);\\n                    color: white;\\n                    padding: 10px 20px;\\n                    border-radius: 5px;\\n                    z-index: 9999;\\n                    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\\n                `;\\n                \\n                // 添加到DOM\\n                document.body.appendChild(successElement);\\n                \\n                // 添加动画类\\n                setTimeout(() => {\\n                    successElement.style.animation = 'notificationFadeIn 0.3s forwards';\\n                }, 10);\\n                \\n                // 3秒后自动淡出并移除\\n                setTimeout(() => {\\n                    successElement.style.animation = 'notificationFadeOut 0.3s forwards';\\n                    setTimeout(() => {\\n                        successElement.remove();\\n                    }, 300);\\n                }, 3000);\\n            },\\n\\n            sendToAPI(characterData) {\\n                try {\\n                    console.log('角色创建完成，准备发送角色数据:', characterData);\\n                    // 显示创建完成的消息\\n                    this.showSuccess(`角色 ${characterData.name} 创建成功！\\\\n请点击场景卡片中的\\\"选择此场景\\\"按钮开